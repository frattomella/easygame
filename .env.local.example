# PostgreSQL / Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/easygame?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/easygame?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"
AUTH_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_EASYGAME_PLATFORM_ADMIN_EMAILS="owner@example.com,vvndrc@gmail.com"
EASYGAME_PLATFORM_ADMIN_EMAILS="owner@example.com,vvndrc@gmail.com"

# Email verification
RESEND_API_KEY=""
AUTH_FROM_EMAIL="EasyGame <noreply@example.com>"

# --- SMS (PP-05, ADR-0114) -------------------------------------------------
#
# Il codice OTP lo genera e lo verifica EasyGame: l'operatore SMS e **solo un
# trasporto**. Cambiarlo non cambia niente della sicurezza del codice.
#
# Valori riconosciuti oggi:
#   ""      nessun trasporto. La verifica del telefono **non blocca**
#           l'accesso: pretendere cio che non si puo consegnare chiuderebbe
#           fuori ogni account nuovo. Il numero si chiede lo stesso.
#   "noop"  trasporto di sviluppo che **non spedisce** e non registra niente,
#           nemmeno il numero. Da solo non basta a far bloccare la verifica:
#           serve anche AUTH_ALLOW_TEST_CODES="true", che restituisce il
#           codice nella risposta.
#
# Un nome che questa versione non conosce **non** ricade su "noop" e **non**
# spegne in silenzio la verifica: viene segnalato una volta dal punto unico
# degli errori, e l'invio resta spento.
#
# Aggiungere un operatore vero e: un file src/lib/server/sms/<nome>-provider.ts,
# una riga in SMS_TRANSPORTS (src/lib/auth/sms-transport.ts) con
# delivers: true, un ramo in resolveSmsProvider, e le sue variabili qui sotto.
# La scelta dell'operatore e una decisione commerciale aperta: vedi ADR-0114.
SMS_PROVIDER=""

# La verifica del telefono blocca la creazione della sessione. Vale "true" se
# non detto altrimenti: il default e la regola, non la deroga. Si spegne solo
# per scelta esplicita, e comunque non blocca mai quando non c'e un trasporto
# che consegni.
AUTH_REQUIRE_PHONE_VERIFICATION="true"

# Il prefisso internazionale usato quando chi si registra non ne scrive uno.
# Un valore malformato torna a "+39" invece di inventare un altro paese.
AUTH_DEFAULT_COUNTRY_CODE="+39"

# Pepe delle impronte OTP. Se assente si ricade su AUTH_RATE_LIMIT_SECRET, poi
# CRON_SECRET, poi DATABASE_URL: quest'ultimo ripiego e **debole di proposito
# solo in sviluppo**, perche chi porta via un dump ha quasi certamente anche la
# stringa di connessione con cui l'ha estratto. In staging e in produzione
# **dichiarare un valore proprio** (vedi 14-security.md).
AUTH_OTP_SECRET=""


# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
