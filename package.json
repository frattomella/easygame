{
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('.next', { recursive: true, force: true });\"",
    "test": "npm run test:unit",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "next lint",
    "local": "node scripts/start-local.mjs",
    "local:dev": "next dev",
    "setup:local": "npm install && prisma generate",
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "db:generate": "prisma generate",
    "db:push": "node scripts/db-guard.mjs \"npm run db:push\" && prisma db push",
    "db:migrate": "node scripts/db-guard.mjs \"npm run db:migrate\" && prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/db-guard.mjs \"npm run prisma:migrate\" && prisma migrate dev",
    "prisma:push": "node scripts/db-guard.mjs \"npm run prisma:push\" && prisma db push",
    "prisma:seed": "node scripts/db-guard.mjs \"npm run prisma:seed\" && node prisma/seed.js",
    "staging:provision-e2e": "node scripts/db-guard.mjs \"npm run staging:provision-e2e\" && node scripts/provision-staging-e2e.mjs",
    "db:status": "prisma migrate status",
    "test:unit": "node --experimental-strip-types --test-concurrency=1 --import ./tests/helpers/register-hooks.mjs --test \"tests/**/*.test.mjs\"",
    "measure:athletes": "node --experimental-strip-types --import ./tests/helpers/register-hooks.mjs scripts/measure-athletes-payload.mjs",
    "measure:multisite": "node --experimental-strip-types --import ./tests/helpers/register-hooks.mjs scripts/measure-multisite-performance.mjs",
    "measure:web": "node --experimental-strip-types --import ./tests/helpers/register-hooks.mjs scripts/measure-web-v1-performance.mjs",
    "attachments:migrate-legacy": "node --experimental-strip-types --import ./tests/helpers/register-hooks.mjs scripts/migrate-legacy-attachments.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.2",
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.3",
    "autoprefixer": "10.4.20",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "embla-carousel-react": "^8.5.2",
    "lucide-react": "^0.468.0",
    "next": "14.2.23",
    "next-themes": "^0.2.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.20.0",
    "prettier": "^3.3.3",
    "radix-ui": "^1.1.3",
    "react": "^18",
    "react-day-picker": "^9.5.1",
    "react-dom": "^18",
    "react-hook-form": "^7.54.2",
    "react-resizable-panels": "^2.1.7",
    "tesseract.js": "^7.0.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "postcss": "^8",
    "prisma": "^6.8.2",
    "tailwind-merge": "^2",
    "tailwindcss": "^3",
    "tailwindcss-animate": "^1",
    "typescript": "^5"
  }
}
