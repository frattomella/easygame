generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                      @id @default(uuid()) @db.Uuid
  email                       String                      @unique
  password_hash               String
  first_name                  String?
  last_name                   String?
  phone                       String?
  email_verified_at           DateTime?
  phone_verified_at           DateTime?
  phone_verification_required Boolean                     @default(false)
  role                        String                      @default("user")
  is_club_creator             Boolean                     @default(false)
  organization_name           String?
  token_verification_id       String?                     @unique
  user_metadata               Json?
  created_at                  DateTime                    @default(now())
  updated_at                  DateTime                    @updatedAt
  sessions                    Session[]
  created_clubs               Club[]                      @relation("ClubCreator")
  club_access                 OrganizationUser[]
  athlete_profiles            Athlete[]
  notifications               Notification[]
  external_accounts           ExternalAccount[]
  verification_challenges     AuthVerificationChallenge[]

  @@map("users")
}

model ExternalAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @db.Uuid
  provider            String
  provider_account_id String
  email               String?
  display_name        String?
  avatar_url          String?
  data                Json?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("external_accounts")
}

model AuthVerificationChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  channel     String
  purpose     String
  target      String
  code_hash   String
  expires_at  DateTime
  consumed_at DateTime?
  attempts    Int       @default(0)
  data        Json?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, channel, purpose])
  @@index([target, channel])
  @@map("auth_verification_challenges")
}

model AuthRateLimitBucket {
  key        String   @id
  scope      String
  count      Int      @default(0)
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([expires_at])
  @@map("auth_rate_limit_buckets")
}

model EmailProviderConfig {
  id                  String    @id
  provider            String    @default("smtp")
  enabled             Boolean   @default(false)
  host                String
  port                Int
  security_mode       String    @default("starttls")
  username            String
  password_ciphertext String
  password_iv         String
  password_tag        String
  from_email          String
  from_name           String
  last_test_at        DateTime?
  last_test_status    String?
  updated_by          String?   @db.Uuid
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@map("email_provider_configs")
}

/// Casella IMAP di piattaforma.
///
/// Tabella separata da `email_provider_configs` di proposito: SMTP e IMAP sono
/// due servizi distinti e le credenziali non vanno condivise ne riutilizzate
/// l'una per l'altro. La riga SMTP porta anche mittente e nome mittente, che
/// per la lettura della posta non hanno senso.
model ImapProviderConfig {
  id                  String    @id
  enabled             Boolean   @default(false)
  host                String
  port                Int
  security_mode       String    @default("ssl")
  username            String
  password_ciphertext String
  password_iv         String
  password_tag        String
  last_test_at        DateTime?
  last_test_status    String?
  updated_by          String?   @db.Uuid
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@map("imap_provider_configs")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  user_id    String   @db.Uuid
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sessions")
}

model Club {
  id                           String                      @id @default(uuid()) @db.Uuid
  slug                         String                      @unique
  name                         String
  creator_id                   String                      @db.Uuid
  logo_url                     String?
  address                      String?
  city                         String?
  postal_code                  String?
  region                       String?
  province                     String?
  country                      String?                     @default("Italia")
  contact_email                String?
  contact_phone                String?
  business_name                String?
  vat_number                   String?
  fiscal_code                  String?
  pec                          String?
  sdi_code                     String?
  tax_regime                   String?
  bank_name                    String?
  iban                         String?
  legal_address                String?
  legal_city                   String?
  legal_postal_code            String?
  legal_region                 String?
  legal_province               String?
  legal_country                String?
  representative_name          String?
  representative_surname       String?
  representative_fiscal_code   String?
  payment_pin                  String?
  settings                     Json?
  categories                   Json?
  trainings                    Json?
  structures                   Json?
  members                      Json?
  trainers                     Json?
  staff_members                Json?
  sponsors                     Json?
  sponsor_payments             Json?
  bank_accounts                Json?
  transactions                 Json?
  expected_income              Json?
  expected_expenses            Json?
  transfers                    Json?
  document_templates           Json?
  matches                      Json?
  weekly_schedule              Json?
  appointments                 Json?
  payment_plans                Json?
  discounts                    Json?
  opening_hours                Json?
  procure                      Json?
  secretariat_notes            Json?
  clothing_kits                Json?
  clothing_inventory           Json?
  clothing_products            Json?
  kit_assignments              Json?
  jersey_groups                Json?
  jersey_assignments           Json?
  dashboard_data               Json?
  created_at                   DateTime                    @default(now())
  updated_at                   DateTime                    @updatedAt
  creator                      User                        @relation("ClubCreator", fields: [creator_id], references: [id], onDelete: Cascade)
  dashboards                   Dashboard[]
  organization_users           OrganizationUser[]
  athletes                     Athlete[]
  medical_certificates         MedicalCertificate[]
  payment_methods              PaymentMethod[]
  payments                     AthletePayment[]
  payment_transactions         PaymentTransaction[]
  invoices                     Invoice[]
  receipts                     Receipt[]
  trainer_payments             TrainerPayment[]
  notifications                Notification[]
  resource_items               ClubResourceItem[]
  training_attendance          TrainingAttendance[]
  athlete_category_memberships AthleteCategoryMembership[]
  attachments                  Attachment[]

  @@map("clubs")
}

model Dashboard {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  creator_id      String?  @db.Uuid
  slug            String   @unique
  settings        Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Club     @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("dashboards")
}

model OrganizationUser {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  role            String
  is_primary      Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Club     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id, role])
  @@index([user_id])
  @@map("organization_users")
}

model Athlete {
  id                   String                      @id @default(uuid()) @db.Uuid
  organization_id      String                      @db.Uuid
  user_id              String?                     @db.Uuid
  first_name           String
  last_name            String
  birth_date           DateTime?
  status               String                      @default("active")
  category_id          String?
  category_name        String?
  access_code          String?
  avatar_url           String?
  jersey_number        String?
  data                 Json?
  created_at           DateTime                    @default(now())
  updated_at           DateTime                    @updatedAt
  organization         Club                        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user                 User?                       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  payments             AthletePayment[]
  payment_transactions PaymentTransaction[]
  invoices             Invoice[]
  receipts             Receipt[]
  medical_certificates MedicalCertificate[]
  category_memberships AthleteCategoryMembership[]

  @@index([organization_id])
  @@index([user_id])
  @@map("athletes")
}

model MedicalCertificate {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  athlete_id      String    @db.Uuid
  type            String
  issue_date      DateTime?
  expiry_date     DateTime?
  file_url        String?
  status          String    @default("valid")
  notes           String?
  data            Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  organization    Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  athlete         Athlete   @relation(fields: [athlete_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([athlete_id])
  @@map("medical_certificates")
}

model PaymentMethod {
  id                        String   @id @default(uuid()) @db.Uuid
  organization_id           String   @db.Uuid
  name                      String
  type                      String
  is_enabled                Boolean  @default(true)
  processing_fee_percentage Float    @default(0)
  processing_fee_fixed      Float    @default(0)
  display_order             Int      @default(0)
  config                    Json?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  organization              Club     @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("payment_methods")
}

/// Una **rata**: quanto e dovuto, entro quando, per cosa.
///
/// `status`, `paid_at` e `method` restano come **cache derivata** dal registro
/// degli incassi (`PaymentTransaction`), non come dato primario: il server li
/// riscrive a ogni incasso registrato o stornato. La fonte di verita e la
/// somma dei movimenti. Vedi ADR-0036.
model AthletePayment {
  id              String               @id @default(uuid()) @db.Uuid
  organization_id String               @db.Uuid
  athlete_id      String?              @db.Uuid
  description     String
  amount          Float
  due_date        DateTime?
  paid_at         DateTime?
  status          String               @default("pending")
  method          String?
  reference       String?
  notes           String?
  data            Json?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  organization    Club                 @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  athlete         Athlete?             @relation(fields: [athlete_id], references: [id], onDelete: SetNull)
  invoice         Invoice?
  receipts        Receipt[]
  transactions    PaymentTransaction[]

  @@index([organization_id])
  @@index([athlete_id])
  @@map("payments")
}

/// Un **incasso**: un movimento di denaro che salda, in tutto o in parte, una
/// rata.
///
/// Esiste perche una rata puo essere incassata in piu volte e con metodi
/// diversi — 50 in contanti, 30 in POS, 50 con bonifico — e perche prima di
/// questa tabella «registrare un pagamento» voleva dire modificare la riga del
/// debito (ADR-0036).
///
/// Un incasso **non si cancella**: si storna. `reversed_at` marca l'originale
/// e `reverses_transaction_id` collega il movimento di segno opposto, cosi
/// restano visibili entrambi e nessuna somma sparisce in silenzio.
model PaymentTransaction {
  id                      String               @id @default(uuid()) @db.Uuid
  organization_id         String               @db.Uuid
  athlete_id              String?              @db.Uuid
  payment_id              String?              @db.Uuid
  amount                  Float
  paid_at                 DateTime
  payment_method          String
  notes                   String?
  /// MANUAL | STRIPE | CEDIPAY | IMPORT | OTHER. Solo MANUAL e implementato.
  source                  String               @default("MANUAL")
  external_reference      String?
  created_by              String?              @db.Uuid
  reversed_at             DateTime?
  reversed_by             String?              @db.Uuid
  reversal_reason         String?
  reverses_transaction_id String?              @db.Uuid
  data                    Json?
  created_at              DateTime             @default(now())
  updated_at              DateTime             @updatedAt
  organization            Club                 @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  athlete                 Athlete?             @relation(fields: [athlete_id], references: [id], onDelete: SetNull)
  payment                 AthletePayment?      @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  reverses                PaymentTransaction?  @relation("PaymentTransactionReversal", fields: [reverses_transaction_id], references: [id], onDelete: SetNull)
  reversals               PaymentTransaction[] @relation("PaymentTransactionReversal")
  receipts                Receipt[]

  @@index([organization_id])
  @@index([athlete_id])
  @@index([payment_id])
  @@map("payment_transactions")
}

model Invoice {
  id              String          @id @default(uuid()) @db.Uuid
  organization_id String          @db.Uuid
  athlete_id      String?         @db.Uuid
  payment_id      String?         @unique @db.Uuid
  invoice_number  String          @unique
  issue_date      DateTime
  amount          Float
  description     String
  payment_method  String?
  status          String          @default("issued")
  is_electronic   Boolean         @default(false)
  recipient_code  String?
  vat_number      String?
  fiscal_code     String?
  address         String?
  city            String?
  postal_code     String?
  province        String?
  country         String?
  notes           String?
  data            Json?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  organization    Club            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  athlete         Athlete?        @relation(fields: [athlete_id], references: [id], onDelete: SetNull)
  payment         AthletePayment? @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  receipts        Receipt[]

  @@index([organization_id])
  @@index([athlete_id])
  @@map("invoices")
}

/// Una **ricevuta**: il documento che attesta un incasso.
///
/// `transaction_id` e il legame nuovo e quello corretto: si rilascia una
/// ricevuta *per incasso*, non per rata, altrimenti una rata pagata in tre
/// volte potrebbe produrne una sola. `payment_id` resta per le ricevute
/// emesse prima del registro degli incassi e **non e piu univoco**: una rata
/// incassata a rate ha piu ricevute (ADR-0036).
model Receipt {
  id              String              @id @default(uuid()) @db.Uuid
  organization_id String              @db.Uuid
  athlete_id      String?             @db.Uuid
  payment_id      String?             @db.Uuid
  transaction_id  String?             @unique @db.Uuid
  invoice_id      String?             @db.Uuid
  receipt_number  String?             @unique
  issue_date      DateTime
  amount          Float
  description     String
  status          String              @default("issued")
  method          String?
  file_url        String?
  data            Json?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  organization    Club                @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  athlete         Athlete?            @relation(fields: [athlete_id], references: [id], onDelete: SetNull)
  payment         AthletePayment?     @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  transaction     PaymentTransaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  invoice         Invoice?            @relation(fields: [invoice_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([athlete_id])
  @@index([payment_id])
  @@map("receipts")
}

model TrainerPayment {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  trainer_id      String?
  trainer_name    String?
  month           String
  amount          Float
  date            DateTime?
  status          String    @default("pending")
  receipt_id      String?
  data            Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  organization    Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("trainer_payments")
}

model Notification {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String?  @db.Uuid
  user_id         String?  @db.Uuid
  title           String
  message         String
  type            String
  read            Boolean  @default(false)
  data            Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Club?    @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  user            User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([user_id])
  @@map("notifications")
}

model ClubResourceItem {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  resource_type   String
  name            String?
  status          String?
  date            DateTime?
  payload         Json
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  organization    Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, resource_type])
  @@map("club_resource_items")
}

model TrainingAttendance {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  training_id     String
  athlete_id      String
  status          String
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Club     @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, training_id])
  @@map("training_attendance")
}

model AthleteCategoryMembership {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  athlete_id      String   @db.Uuid
  category_id     String
  category_name   String?
  is_primary      Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Club     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  athlete         Athlete  @relation(fields: [athlete_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, athlete_id, category_id])
  @@index([organization_id])
  @@index([athlete_id])
  @@index([organization_id, athlete_id, is_primary])
  @@map("athlete_category_memberships")
}

/// Allegato: metadati. I byte stanno in `AttachmentBlob`, mai qui.
///
/// La separazione non e cosmetica: elencare gli allegati di un atleta deve
/// costare quanto elencare dei nomi. Se il binario fosse su questa riga, ogni
/// `findMany` lo trascinerebbe fuori dal TOAST — che e esattamente il difetto
/// di `athletes.data` che questa tabella esiste per chiudere (WP-15).
///
/// `storage_driver` dice **dove** sono i byte. Oggi vale sempre `database`;
/// il giorno in cui si configura un object storage le righe nuove valgono un
/// altro driver e portano una `storage_key` invece di un blob, senza che il
/// resto dell'applicazione cambi. Vedi ADR-0034.
model Attachment {
  id              String          @id @default(uuid()) @db.Uuid
  organization_id String          @db.Uuid
  owner_type      String
  owner_id        String
  category        String
  file_name       String
  mime_type       String
  size_bytes      Int
  checksum        String
  storage_driver  String          @default("database")
  storage_key     String?
  created_by      String?         @db.Uuid
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  organization    Club            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  blob            AttachmentBlob?

  @@index([organization_id])
  @@index([organization_id, owner_type, owner_id])
  @@index([organization_id, checksum])
  @@map("attachments")
}

/// I byte di un allegato memorizzato con il driver `database`.
///
/// Tabella a se perche non si legge quasi mai: la si tocca solo quando
/// qualcuno apre o scarica davvero il file.
model AttachmentBlob {
  attachment_id String     @id @db.Uuid
  content       Bytes
  attachment    Attachment @relation(fields: [attachment_id], references: [id], onDelete: Cascade)

  @@map("attachment_blobs")
}

model Asset {
  id          String   @id @default(uuid()) @db.Uuid
  bucket      String
  path        String
  public_url  String
  file_name   String?
  mime_type   String?
  data_base64 String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([bucket, path])
  @@map("assets")
}

/// Traccia delle operazioni sensibili: chi ha fatto cosa, su quale club,
/// con quale esito. Vedi ADR-0019 e docs/knowledge-base/14-security.md.
///
/// Non deve mai contenere password, hash, token, codici OTP o credenziali:
/// `recordAuditEvent` filtra i metadati prima di scrivere.
model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  action          String
  outcome         String   @default("success")
  actor_user_id   String?  @db.Uuid
  actor_email     String?
  actor_role      String?
  organization_id String?  @db.Uuid
  resource        String?
  resource_id     String?
  ip              String?
  user_agent      String?
  metadata        Json?
  created_at      DateTime @default(now())

  @@index([organization_id, created_at])
  @@index([actor_user_id, created_at])
  @@index([action, created_at])
  @@index([created_at])
  @@map("audit_logs")
}
