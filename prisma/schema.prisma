generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                      @id @default(uuid()) @db.Uuid
  email                       String                      @unique
  password_hash               String
  first_name                  String?
  last_name                   String?
  phone                       String?
  email_verified_at           DateTime?
  phone_verified_at           DateTime?
  phone_verification_required Boolean                     @default(false)
  role                        String                      @default("user")
  is_club_creator             Boolean                     @default(false)
  organization_name           String?
  token_verification_id       String?                     @unique
  user_metadata               Json?
  created_at                  DateTime                    @default(now())
  updated_at                  DateTime                    @updatedAt
  sessions                    Session[]
  created_clubs               Club[]                      @relation("ClubCreator")
  club_access                 OrganizationUser[]
  athlete_profiles            Athlete[]
  notifications               Notification[]
  external_accounts           ExternalAccount[]
  verification_challenges     AuthVerificationChallenge[]

  @@map("users")
}

model ExternalAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @db.Uuid
  provider            String
  provider_account_id String
  email               String?
  display_name        String?
  avatar_url          String?
  data                Json?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("external_accounts")
}

model AuthVerificationChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  channel     String
  purpose     String
  target      String
  code_hash   String
  expires_at  DateTime
  consumed_at DateTime?
  attempts    Int       @default(0)
  data        Json?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, channel, purpose])
  @@index([target, channel])
  @@map("auth_verification_challenges")
}

model AuthRateLimitBucket {
  key        String   @id
  scope      String
  count      Int      @default(0)
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([expires_at])
  @@map("auth_rate_limit_buckets")
}

model EmailProviderConfig {
  id                  String    @id
  provider            String    @default("smtp")
  enabled             Boolean   @default(false)
  host                String
  port                Int
  security_mode       String    @default("starttls")
  username            String
  password_ciphertext String
  password_iv         String
  password_tag        String
  from_email          String
  from_name           String
  last_test_at        DateTime?
  last_test_status    String?
  updated_by          String?   @db.Uuid
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@map("email_provider_configs")
}

/// Casella IMAP di piattaforma.
///
/// Tabella separata da `email_provider_configs` di proposito: SMTP e IMAP sono
/// due servizi distinti e le credenziali non vanno condivise ne riutilizzate
/// l'una per l'altro. La riga SMTP porta anche mittente e nome mittente, che
/// per la lettura della posta non hanno senso.
model ImapProviderConfig {
  id                  String    @id
  enabled             Boolean   @default(false)
  host                String
  port                Int
  security_mode       String    @default("ssl")
  username            String
  password_ciphertext String
  password_iv         String
  password_tag        String
  last_test_at        DateTime?
  last_test_status    String?
  updated_by          String?   @db.Uuid
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@map("imap_provider_configs")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  user_id    String   @db.Uuid
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sessions")
}

model Club {
  id                           String                          @id @default(uuid()) @db.Uuid
  slug                         String                          @unique
  name                         String
  creator_id                   String                          @db.Uuid
  logo_url                     String?
  address                      String?
  city                         String?
  postal_code                  String?
  region                       String?
  province                     String?
  country                      String?                         @default("Italia")
  contact_email                String?
  contact_phone                String?
  business_name                String?
  vat_number                   String?
  fiscal_code                  String?
  pec                          String?
  sdi_code                     String?
  tax_regime                   String?
  bank_name                    String?
  iban                         String?
  legal_address                String?
  legal_city                   String?
  legal_postal_code            String?
  legal_region                 String?
  legal_province               String?
  legal_country                String?
  representative_name          String?
  representative_surname       String?
  representative_fiscal_code   String?
  payment_pin                  String?
  settings                     Json?
  categories                   Json?
  trainings                    Json?
  structures                   Json?
  members                      Json?
  trainers                     Json?
  staff_members                Json?
  sponsors                     Json?
  sponsor_payments             Json?
  bank_accounts                Json?
  transactions                 Json?
  expected_income              Json?
  expected_expenses            Json?
  transfers                    Json?
  document_templates           Json?
  matches                      Json?
  weekly_schedule              Json?
  appointments                 Json?
  payment_plans                Json?
  discounts                    Json?
  opening_hours                Json?
  procure                      Json?
  secretariat_notes            Json?
  clothing_kits                Json?
  clothing_inventory           Json?
  clothing_products            Json?
  kit_assignments              Json?
  jersey_groups                Json?
  jersey_assignments           Json?
  /// Sedi operative del club (ADR-0038). Vuoto o con una sola voce = club
  /// mono-sede: l'interfaccia non mostra nessun filtro sede.
  club_sites                   Json?
  /// Gruppi operativi: la coppia (categoria, sede). Non duplicano la
  /// categoria, la collocano.
  category_groups              Json?
  dashboard_data               Json?
  created_at                   DateTime                        @default(now())
  updated_at                   DateTime                        @updatedAt
  creator                      User                            @relation("ClubCreator", fields: [creator_id], references: [id], onDelete: Cascade)
  dashboards                   Dashboard[]
  organization_users           OrganizationUser[]
  athletes                     Athlete[]
  medical_certificates         MedicalCertificate[]
  payment_methods              PaymentMethod[]
  payments                     AthletePayment[]
  payment_transactions         PaymentTransaction[]
  invoices                     Invoice[]
  receipts                     Receipt[]
  trainer_payments             TrainerPayment[]
  notifications                Notification[]
  resource_items               ClubResourceItem[]
  training_attendance          TrainingAttendance[]
  athlete_category_memberships AthleteCategoryMembership[]
  attachments                  Attachment[]
  funding_programs             FundingProgram[]
  funding_enrollments          FundingEnrollment[]
  funding_accruals             FundingAccrual[]
  funding_settlements          FundingSettlement[]
  funding_settlement_lines     FundingSettlementLine[]
  form_templates               FormTemplate[]
  form_submissions             FormSubmission[]
  document_number_sequences    DocumentNumberSequence[]
  payment_webhook_events       PaymentWebhookEvent[]
  commission_rules             PlatformCommissionRule[]
  payment_account              ClubPaymentAccount?
  billing_account              PlatformBillingAccount?
  fiscal_profile               OrganizationFiscalProfile?
  document_series              DocumentSeries[]
  fiscal_operation_types       FiscalOperationType[]
  einvoice_transmissions       EInvoiceTransmission[]
  sport_work_people            SportWorkPerson[]
  sport_work_relationships     SportWorkRelationship[]
  sport_work_plans             SportWorkCompensationPlan[]
  sport_work_installments      SportWorkInstallment[]
  sport_work_transactions      SportWorkOutboundTransaction[]
  sport_work_declarations      SportWorkExternalDeclaration[]
  sport_work_year_positions    SportWorkYearPosition[]
  sport_work_bonuses           SportWorkBonus[]
  sport_work_reimbursements    SportWorkExpenseReimbursement[]
  sport_work_vat_invoices      SportWorkVatInvoice[]
  sport_work_obligations       SportWorkObligation[]
  communication_deliveries     CommunicationDelivery[]
  payment_links                PaymentLink[]
  document_template_records    DocumentTemplate[]
  generated_documents          GeneratedDocument[]
  consent_definitions          ConsentDefinition[]
  consent_records              ConsentRecord[]

  @@map("clubs")
}

model Dashboard {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  creator_id      String?  @db.Uuid
  slug            String   @unique
  settings        Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Club     @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("dashboards")
}

model OrganizationUser {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  role            String
  is_primary      Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Club     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id, role])
  @@index([user_id])
  @@map("organization_users")
}

model Athlete {
  id                   String                      @id @default(uuid()) @db.Uuid
  organization_id      String                      @db.Uuid
  user_id              String?                     @db.Uuid
  first_name           String
  last_name            String
  birth_date           DateTime?
  status               String                      @default("active")
  category_id          String?
  category_name        String?
  access_code          String?
  avatar_url           String?
  jersey_number        String?
  data                 Json?
  created_at           DateTime                    @default(now())
  updated_at           DateTime                    @updatedAt
  organization         Club                        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user                 User?                       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  payments             AthletePayment[]
  payment_transactions PaymentTransaction[]
  funding_enrollments  FundingEnrollment[]
  invoices             Invoice[]
  receipts             Receipt[]
  medical_certificates MedicalCertificate[]
  category_memberships AthleteCategoryMembership[]

  @@index([organization_id])
  @@index([user_id])
  @@map("athletes")
}

model MedicalCertificate {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  athlete_id      String    @db.Uuid
  type            String
  issue_date      DateTime?
  expiry_date     DateTime?
  file_url        String?
  status          String    @default("valid")
  notes           String?
  data            Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  organization    Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  athlete         Athlete   @relation(fields: [athlete_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([athlete_id])
  @@map("medical_certificates")
}

model PaymentMethod {
  id                        String   @id @default(uuid()) @db.Uuid
  organization_id           String   @db.Uuid
  name                      String
  type                      String
  is_enabled                Boolean  @default(true)
  processing_fee_percentage Float    @default(0)
  processing_fee_fixed      Float    @default(0)
  display_order             Int      @default(0)
  config                    Json?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  organization              Club     @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("payment_methods")
}

/// Una **rata**: quanto e dovuto, entro quando, per cosa.
///
/// `status`, `paid_at` e `method` restano come **cache derivata** dal registro
/// degli incassi (`PaymentTransaction`), non come dato primario: il server li
/// riscrive a ogni incasso registrato o stornato. La fonte di verita e la
/// somma dei movimenti. Vedi ADR-0036.
model AthletePayment {
  id              String               @id @default(uuid()) @db.Uuid
  organization_id String               @db.Uuid
  athlete_id      String?              @db.Uuid
  description     String
  amount          Float
  due_date        DateTime?
  paid_at         DateTime?
  status          String               @default("pending")
  method          String?
  reference       String?
  notes           String?
  data            Json?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  organization    Club                 @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  athlete         Athlete?             @relation(fields: [athlete_id], references: [id], onDelete: SetNull)
  invoice         Invoice?
  receipts        Receipt[]
  transactions    PaymentTransaction[]

  @@index([organization_id])
  @@index([athlete_id])
  @@map("payments")
}

/// Un **incasso**: un movimento di denaro che salda, in tutto o in parte, una
/// rata.
///
/// Esiste perche una rata puo essere incassata in piu volte e con metodi
/// diversi — 50 in contanti, 30 in POS, 50 con bonifico — e perche prima di
/// questa tabella «registrare un pagamento» voleva dire modificare la riga del
/// debito (ADR-0036).
///
/// Un incasso **non si cancella**: si storna. `reversed_at` marca l'originale
/// e `reverses_transaction_id` collega il movimento di segno opposto, cosi
/// restano visibili entrambi e nessuna somma sparisce in silenzio.
model PaymentTransaction {
  id                      String               @id @default(uuid()) @db.Uuid
  organization_id         String               @db.Uuid
  athlete_id              String?              @db.Uuid
  payment_id              String?              @db.Uuid
  amount                  Float
  paid_at                 DateTime
  payment_method          String
  notes                   String?
  /// MANUAL | STRIPE | IMPORT | OTHER, piu `CEDIPAY` per le righe scritte prima
  /// di ADR-0049. Un incasso online lo scrive solo il webhook firmato.
  source                  String               @default("MANUAL")
  external_reference      String?
  created_by              String?              @db.Uuid
  reversed_at             DateTime?
  reversed_by             String?              @db.Uuid
  reversal_reason         String?
  reverses_transaction_id String?              @db.Uuid
  /**
   * ------------------------------------------------------ riconciliazione
   * I numeri di un incasso online, **congelati nel momento in cui e
   * avvenuto**. Ricostruirli dopo dalla configurazione corrente darebbe la
   * commissione di oggi su un incasso di sei mesi fa: e il difetto che
   * ADR-0050 chiude. Nulli su un incasso manuale, che commissioni non ne ha.
   */
  currency                String               @default("EUR")
  /// Lordo pagato dalla famiglia, in centesimi.
  gross_amount_cents      Int?
  /// Commissione EasyGame trattenuta. Congelata: non si ricalcola mai.
  platform_fee_cents      Int?
  /// Commissione del PSP, quando l'evento la porta con se. Spesso arriva dopo.
  provider_fee_cents      Int?
  /// Quanto resta al club, calcolato al momento del fatto.
  net_amount_cents        Int?
  /// La percentuale applicata: spiega il numero anche senza rileggere la regola.
  applied_fee_percent     Float?
  applied_fee_fixed_cents Int?
  /// La regola che ha prodotto quei numeri. Riferimento debole, per la riconciliazione.
  commission_rule_id      String?              @db.Uuid
  /// L'account connesso su cui il denaro e entrato.
  external_account_id     String?
  /// PaymentIntent o Charge: con cui si riconcilia sul cruscotto del PSP.
  external_payment_id     String?
  /// L'evento che ha prodotto questa riga: dalla riga si risale al fatto.
  external_event_id       String?
  /// Il tipo di operazione dichiarato, quando si conosce. Vedi FiscalOperationType.
  operation_type_code     String?
  data                    Json?
  created_at              DateTime             @default(now())
  updated_at              DateTime             @updatedAt
  organization            Club                 @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  athlete                 Athlete?             @relation(fields: [athlete_id], references: [id], onDelete: SetNull)
  payment                 AthletePayment?      @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  reverses                PaymentTransaction?  @relation("PaymentTransactionReversal", fields: [reverses_transaction_id], references: [id], onDelete: SetNull)
  reversals               PaymentTransaction[] @relation("PaymentTransactionReversal")
  receipts                Receipt[]
  transaction_invoices    Invoice[]

  @@index([organization_id])
  @@index([athlete_id])
  @@index([payment_id])
  @@index([external_payment_id])
  @@map("payment_transactions")
}

/// Una **fattura**: un documento fiscale con un intestatario e una
/// numerazione propria.
///
/// **Perche porta uno snapshot.** Un documento emesso racconta com'erano le
/// cose il giorno in cui e stato emesso. Se domani l'atleta trasloca, o il
/// tutore corregge il proprio codice fiscale, la fattura gia emessa **non
/// deve cambiare**: sarebbe un documento diverso da quello consegnato. I
/// campi sciolti (`vat_number`, `address`, ...) restano perche mezza
/// applicazione li legge; `snapshot` e la fotografia completa e autorevole.
/// Vedi ADR-0052.
model Invoice {
  id                  String                @id @default(uuid()) @db.Uuid
  organization_id     String                @db.Uuid
  athlete_id          String?               @db.Uuid
  payment_id          String?               @unique @db.Uuid
  /// L'incasso documentato. Prima viveva dentro `data.transactionId`.
  transaction_id      String?               @db.Uuid
  invoice_number      String
  /// Il codice della serie. Vuoto = serie predefinita.
  series              String                @default("")
  /// Il progressivo dentro la serie e l'anno. Ridondante con il numero, e apposta.
  sequence            Int?
  document_year       Int?
  /// Vedi `FiscalOperationType.code`.
  operation_type_code String?
  /// La fotografia dei dati fiscalmente rilevanti al momento dell'emissione.
  snapshot            Json?
  cancelled_at        DateTime?
  cancelled_by        String?               @db.Uuid
  cancellation_reason String?
  /// Il documento che questo rettifica o annulla.
  cancels_document_id String?               @db.Uuid
  issued_by           String?               @db.Uuid
  issue_date          DateTime
  amount              Float
  description         String
  payment_method      String?
  status              String                @default("issued")
  is_electronic       Boolean               @default(false)
  recipient_code      String?
  vat_number          String?
  fiscal_code         String?
  address             String?
  city                String?
  postal_code         String?
  province            String?
  country             String?
  notes               String?
  data                Json?
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  organization        Club                  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  athlete             Athlete?              @relation(fields: [athlete_id], references: [id], onDelete: SetNull)
  payment             AthletePayment?       @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  transaction         PaymentTransaction?   @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  receipts            Receipt[]
  einvoice            EInvoiceTransmission?

  @@unique([organization_id, invoice_number])
  @@index([organization_id])
  @@index([athlete_id])
  @@index([transaction_id])
  @@map("invoices")
}

/// Una **ricevuta**: il documento che attesta un incasso.
///
/// `transaction_id` e il legame nuovo e quello corretto: si rilascia una
/// ricevuta *per incasso*, non per rata, altrimenti una rata pagata in tre
/// volte potrebbe produrne una sola. `payment_id` resta per le ricevute
/// emesse prima del registro degli incassi e **non e piu univoco**: una rata
/// incassata a rate ha piu ricevute (ADR-0036).
model Receipt {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  athlete_id          String?             @db.Uuid
  payment_id          String?             @db.Uuid
  transaction_id      String?             @unique @db.Uuid
  invoice_id          String?             @db.Uuid
  receipt_number      String?
  /// Il codice della serie. Vuoto = serie predefinita.
  series              String              @default("")
  sequence            Int?
  document_year       Int?
  operation_type_code String?
  /// La fotografia dei dati al momento dell'emissione: vedi la nota su Invoice.
  snapshot            Json?
  cancelled_at        DateTime?
  cancelled_by        String?             @db.Uuid
  cancellation_reason String?
  cancels_document_id String?             @db.Uuid
  issued_by           String?             @db.Uuid
  issue_date          DateTime
  amount              Float
  description         String
  status              String              @default("issued")
  method              String?
  file_url            String?
  data                Json?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  organization        Club                @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  athlete             Athlete?            @relation(fields: [athlete_id], references: [id], onDelete: SetNull)
  payment             AthletePayment?     @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  transaction         PaymentTransaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  invoice             Invoice?            @relation(fields: [invoice_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, receipt_number])
  @@index([organization_id])
  @@index([athlete_id])
  @@index([payment_id])
  @@map("receipts")
}

/// La **sequenza** di numerazione di un tipo di documento, per club e anno.
///
/// **Perche una tabella e non un conteggio.** Contare le righe gia emesse non
/// e sicuro sotto concorrenza — due operatori che incassano nello stesso
/// istante contano lo stesso numero — e non e nemmeno corretto: una ricevuta
/// annullata non deve far riusare il suo numero. La sequenza si incrementa,
/// non si ricava.
///
/// **Perche la chiave e (club, tipo, anno).** Un numero di documento
/// appartiene a un club e a un esercizio: la societa Alfa e la societa Beta
/// hanno entrambe la loro ricevuta 1 del 2026, e devono averla. Vedi
/// ADR-0044.
/// Un evento gia ricevuto da un provider di pagamento.
///
/// **Perche non basta la firma.** La firma dice che l'evento viene davvero
/// dal provider; non dice che sia la prima volta che arriva. Stripe riprova
/// la consegna per tre giorni finche non riceve un 2xx, e un rinvio manuale e
/// a un clic di distanza. Senza questa tabella, un evento consegnato due
/// volte registra l'incasso due volte. Vedi ADR-0045.
///
/// Il corpo dell'evento **non** si conserva: contiene l'email di chi paga e
/// i riferimenti dell'account connesso, e nessuno lo rilegge.
model PaymentWebhookEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  /// `stripe` | `paypal` | ... Vedi `PaymentGatewayKey`.
  provider            String
  /// `connect` (atleta -> club) oppure `platform` (club -> Cedi Soft).
  /// Sono due account Stripe e due segreti diversi: senza questo campo, un
  /// evento dell'uno potrebbe essere elaborato come evento dell'altro.
  flow                String   @default("connect")
  /// L'account connesso che ha generato l'evento, quando ce n'e uno.
  external_account_id String?
  /// L'identificativo dell'evento presso il provider: la chiave di deduplica.
  event_id            String
  event_type          String
  organization_id     String?  @db.Uuid
  external_reference  String?
  /// `processed` | `ignored` | `failed`
  status              String   @default("processed")
  error               String?
  received_at         DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  organization        Club?    @relation(fields: [organization_id], references: [id], onDelete: SetNull)

  @@unique([provider, event_id])
  @@index([organization_id])
  @@map("payment_webhook_events")
}

model DocumentNumberSequence {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  /// `receipt` | `invoice` | `credit_note`. Vedi `DOCUMENT_NUMBER_KINDS`.
  kind            String
  /// La serie. Vuoto = serie predefinita, ed e cio che avevano tutte le righe
  /// esistenti prima del Blocco D: la migrazione non le tocca.
  series          String   @default("")
  year            Int
  last_number     Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Club     @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, kind, series, year])
  @@map("document_number_sequences")
}

/// Un **programma di contributo**: un bando, un voucher, un contributo di ente.
///
/// Tutto cio che distingue un bando dall'altro e **configurazione**, non
/// codice: importo per periodo, frequenza del periodo, requisito minimo, unita
/// del requisito, cosa succede se il requisito non e raggiunto, tetti. Il
/// Voucher per lo Sport della Regione Lazio 2025 e uno dei valori possibili di
/// queste colonne, non un ramo dentro il calcolo. Vedi ADR-0037.
model FundingProgram {
  id                 String              @id @default(uuid()) @db.Uuid
  organization_id    String              @db.Uuid
  name               String
  /// Chi finanzia: «Regione Lazio», «Sport e Salute», il comune, un privato.
  funder_name        String
  /// draft | active | closed
  status             String              @default("draft")
  valid_from         DateTime
  valid_to           DateTime
  /// **Massimale del programma** per beneficiario: il tetto che il bando pone.
  /// Non e l'importo assegnato presso questo club, che sta su
  /// `funding_enrollments.assigned_amount` e puo essere piu basso (ADR-0054).
  athlete_plafond    Float
  /// easygame_attendance | external_confirmation | external_import | external_api
  ///
  /// Dice se le presenze EasyGame sono la fonte ufficiale della maturazione o
  /// soltanto una previsione in attesa di conferma esterna.
  accrual_source     String              @default("easygame_attendance")
  /// Importo riconosciuto per un periodo che matura per intero.
  period_amount      Float
  /// monthly | days
  period_frequency   String              @default("monthly")
  /// Lunghezza del periodo quando la frequenza e `days`.
  period_length_days Int?
  /// hours | sessions
  requirement_unit   String              @default("hours")
  /// Quanto serve per far maturare il periodo, nell'unita dichiarata.
  requirement_min    Float               @default(0)
  /// none | prorata | full — cosa succede sotto la soglia.
  unmet_behavior     String              @default("none")
  /// Tetto opzionale al numero di periodi che possono maturare.
  max_periods        Int?
  /// Tetto opzionale all'importo complessivo del programma, su tutti i beneficiari.
  max_total_amount   Float?
  notes              String?
  data               Json?
  created_by         String?             @db.Uuid
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  organization       Club                @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  enrollments        FundingEnrollment[]
  settlements        FundingSettlement[]

  @@index([organization_id])
  @@map("funding_programs")
}

/// Un **atleta ammesso** a un programma: il suo plafond e il suo codice voucher.
///
/// `assigned_amount` e quanto gli e stato *assegnato*, che non e denaro
/// incassato ne denaro maturato: e il tetto entro cui potra maturare.
model FundingEnrollment {
  id              String           @id @default(uuid()) @db.Uuid
  organization_id String           @db.Uuid
  program_id      String           @db.Uuid
  athlete_id      String           @db.Uuid
  /// Codice individuale del voucher, quando l'ente ne assegna uno.
  voucher_code    String?
  assigned_amount Float
  /// active | suspended | closed
  status          String           @default("active")
  enrolled_at     DateTime
  ends_at         DateTime?
  notes           String?
  data            Json?
  created_by      String?          @db.Uuid
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  organization    Club             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  program         FundingProgram   @relation(fields: [program_id], references: [id], onDelete: Cascade)
  athlete         Athlete          @relation(fields: [athlete_id], references: [id], onDelete: Cascade)
  accruals        FundingAccrual[]

  @@unique([program_id, athlete_id])
  @@index([organization_id])
  @@index([athlete_id])
  @@map("funding_enrollments")
}

/// Il **maturato di un periodo** per un beneficiario.
///
/// Il periodo non ha una tabella propria: e un intervallo di date che si
/// ricava dalla configurazione del programma (`generateFundingPeriods`), e
/// salvarlo sarebbe una seconda fonte di verita per qualcosa di derivabile —
/// con il rischio classico, che le due divergano quando il programma cambia.
/// Qui il periodo e denormalizzato **dentro il maturato**, dove serve a
/// spiegare un importo che e gia stato calcolato.
///
/// `measured_value` e cio che le presenze dicono; `accrued_amount` e cio che
/// ne matura. Sono due numeri diversi di proposito: sotto la soglia il primo
/// puo essere alto e il secondo zero.
model FundingAccrual {
  id                 String                  @id @default(uuid()) @db.Uuid
  organization_id    String                  @db.Uuid
  enrollment_id      String                  @db.Uuid
  period_index       Int
  period_start       DateTime
  period_end         DateTime
  period_label       String
  requirement_min    Float
  requirement_unit   String
  measured_value     Float                   @default(0)
  requirement_met    Boolean                 @default(false)
  /// Importo che il periodo varrebbe se maturasse per intero.
  eligible_amount    Float                   @default(0)
  /// **Previsione EasyGame**: quanto il periodo varrebbe secondo l'appello
  /// registrato qui. Con la fonte esterna resta un numero da leggere mentre
  /// `accrued_amount` resta zero fino alla conferma (ADR-0054).
  estimated_amount   Float                   @default(0)
  /// Importo effettivamente maturato, dopo soglia, assegnato e conferma.
  accrued_amount     Float                   @default(0)
  /// Quanto e andato perso: `eligible_amount - accrued_amount`.
  unaccrued_amount   Float                   @default(0)
  /// not_accrued | pending_confirmation | accrued | reported | settled
  status             String                  @default("not_accrued")
  /// easygame_attendance | manual_confirmation | external_import | external_api
  accrual_origin     String?
  confirmed_at       DateTime?
  confirmed_by       String?                 @db.Uuid
  /// Riferimento della fonte esterna: protocollo, id pratica, nome del file.
  external_reference String?
  confirmation_notes String?
  reported_at        DateTime?
  reported_by        String?                 @db.Uuid
  computed_at        DateTime
  data               Json?
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt
  organization       Club                    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  enrollment         FundingEnrollment       @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  settlement_lines   FundingSettlementLine[]

  @@unique([enrollment_id, period_index])
  @@index([organization_id])
  @@map("funding_accruals")
}

/// Una **liquidazione dell'ente**: denaro che il finanziatore versa al club.
///
/// E l'unico momento in cui il contributo diventa denaro reale. Fino a qui il
/// maturato e un credito, e il Riepilogo Incassi lo tiene separato da cio che
/// e stato davvero incassato.
model FundingSettlement {
  id              String                  @id @default(uuid()) @db.Uuid
  organization_id String                  @db.Uuid
  program_id      String                  @db.Uuid
  reference       String?
  settled_at      DateTime
  amount          Float
  method          String?
  notes           String?
  created_by      String?                 @db.Uuid
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt
  organization    Club                    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  program         FundingProgram          @relation(fields: [program_id], references: [id], onDelete: Cascade)
  lines           FundingSettlementLine[]

  @@index([organization_id])
  @@index([program_id])
  @@map("funding_settlements")
}

/// La **riconciliazione**: quanto di una liquidazione copre quale periodo di
/// quale atleta.
///
/// Esiste perche un ente liquida in blocco — un bonifico solo per venti atleti
/// e tre mesi — e senza queste righe «liquidato» sarebbe un totale che non si
/// puo attribuire a nessuno.
model FundingSettlementLine {
  id              String            @id @default(uuid()) @db.Uuid
  organization_id String            @db.Uuid
  settlement_id   String            @db.Uuid
  accrual_id      String            @db.Uuid
  amount          Float
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  organization    Club              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  settlement      FundingSettlement @relation(fields: [settlement_id], references: [id], onDelete: Cascade)
  accrual         FundingAccrual    @relation(fields: [accrual_id], references: [id], onDelete: Cascade)

  @@unique([settlement_id, accrual_id])
  @@index([organization_id])
  @@index([accrual_id])
  @@map("funding_settlement_lines")
}

model TrainerPayment {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  trainer_id      String?
  trainer_name    String?
  month           String
  amount          Float
  date            DateTime?
  status          String    @default("pending")
  receipt_id      String?
  data            Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  organization    Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("trainer_payments")
}

model Notification {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String?  @db.Uuid
  user_id         String?  @db.Uuid
  title           String
  message         String
  type            String
  read            Boolean  @default(false)
  data            Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Club?    @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  user            User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([user_id])
  @@map("notifications")
}

model ClubResourceItem {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  resource_type   String
  name            String?
  status          String?
  date            DateTime?
  payload         Json
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  organization    Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, resource_type])
  @@map("club_resource_items")
}

/// Presenze e conferme sull'evento: **due fatti diversi sulla stessa riga**.
///
/// `status` e la **presenza**, cioe il fatto registrato dall'allenatore con
/// l'appello. La legge `src/lib/funding/attendance-measure.ts` per misurare la
/// frequenza con cui si rendicontano i contributi pubblici.
///
/// `rsvp_*` e l'**intenzione**, cioe la risposta della famiglia all'invito.
/// Non e una presenza e non lo diventa mai: se un «si» scrivesse `status`, un
/// contributo verrebbe rendicontato su una promessa che nessuno ha verificato.
/// Vedi ADR-0086.
///
/// La chiave unica non c'era, e il client compensava cancellando a mano le
/// righe duplicate dopo averle trovate (`simplified-db.ts`). Con una risposta
/// della famiglia sulla stessa riga, due righe significano due risposte
/// contraddittorie per lo stesso atleta.
model TrainingAttendance {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  training_id     String
  athlete_id      String
  /// La presenza: `present` | `absent`, scritta dall'appello dell'allenatore,
  /// piu `pending` sulle righe **nate da una risposta** e mai passate
  /// dall'appello (`RSVP_NEUTRAL_ATTENDANCE_STATUS`). `pending` non e una
  /// presenza: `isPresentAttendance` lo rifiuta, quindi non entra in nessuna
  /// rendicontazione di contributi.
  status          String
  notes           String?
  /// L'intenzione dichiarata dalla famiglia: `yes` | `no`. Mai scritta dall'appello.
  rsvp_status     String?
  rsvp_note       String?
  rsvp_at         DateTime?
  rsvp_by_user_id String?   @db.Uuid
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  organization    Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, training_id, athlete_id])
  @@index([organization_id, training_id])
  @@index([organization_id, athlete_id, rsvp_status])
  @@map("training_attendance")
}

model AthleteCategoryMembership {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  athlete_id      String   @db.Uuid
  category_id     String
  category_name   String?
  is_primary      Boolean  @default(false)
  /// Sede in cui l'atleta svolge questa categoria (ADR-0038). `null` sul dato
  /// precedente alle sedi e su ogni club mono-sede.
  site_id         String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Club     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  athlete         Athlete  @relation(fields: [athlete_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, athlete_id, category_id])
  @@index([organization_id])
  @@index([athlete_id])
  @@index([organization_id, athlete_id, is_primary])
  @@index([organization_id, site_id])
  @@map("athlete_category_memberships")
}

/// Allegato: metadati. I byte stanno in `AttachmentBlob`, mai qui.
///
/// La separazione non e cosmetica: elencare gli allegati di un atleta deve
/// costare quanto elencare dei nomi. Se il binario fosse su questa riga, ogni
/// `findMany` lo trascinerebbe fuori dal TOAST — che e esattamente il difetto
/// di `athletes.data` che questa tabella esiste per chiudere (WP-15).
///
/// `storage_driver` dice **dove** sono i byte. Oggi vale sempre `database`;
/// il giorno in cui si configura un object storage le righe nuove valgono un
/// altro driver e portano una `storage_key` invece di un blob, senza che il
/// resto dell'applicazione cambi. Vedi ADR-0034.
model Attachment {
  id              String          @id @default(uuid()) @db.Uuid
  organization_id String          @db.Uuid
  owner_type      String
  owner_id        String
  category        String
  file_name       String
  mime_type       String
  size_bytes      Int
  checksum        String
  storage_driver  String          @default("database")
  storage_key     String?
  /// Da quando il documento vale. Quasi sempre la data di rilascio.
  ///
  /// **Perche la validita sta qui e non in un archivio nuovo** (Wave 3, W3-G).
  /// La scadenza di un documento e una proprieta **del documento**, e il
  /// documento e questa riga. Prima della Wave 3 viveva in campi JSON liberi
  /// (`staffMemberData.documentExpiry`) che nessuno leggeva: un documento
  /// d'identita scaduto lo scopriva chi lo cercava.
  ///
  /// Il **certificato medico non passa di qui**: ha `medical_certificates`
  /// con una semantica propria (mancante / in scadenza / scaduto) e la sua
  /// automazione `AUT-03`. Due fonti per la stessa scadenza vorrebbero dire
  /// due promemoria per lo stesso fatto.
  valid_from      DateTime?
  /// Fino a quando il documento vale. `null` = non scade.
  ///
  /// Lo **stato** (valido / in scadenza / scaduto) non e una colonna: si
  /// ricava da questa data e da oggi, come lo stato di una rata e quello di
  /// una scadenza del lavoro sportivo. Scriverlo vorrebbe dire tenerlo
  /// aggiornato, e nessun giro notturno puo garantirlo per ogni riga.
  valid_until     DateTime?
  created_by      String?         @db.Uuid
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  organization    Club            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  blob            AttachmentBlob?

  @@index([organization_id])
  @@index([organization_id, owner_type, owner_id])
  @@index([organization_id, checksum])
  /// Il giro notturno delle scadenze cerca «cosa scade fra N giorni in questo
  /// club»: senza questo indice sarebbe una scansione di tutti gli allegati.
  @@index([organization_id, valid_until])
  @@map("attachments")
}

/// I byte di un allegato memorizzato con il driver `database`.
///
/// Tabella a se perche non si legge quasi mai: la si tocca solo quando
/// qualcuno apre o scarica davvero il file.
model AttachmentBlob {
  attachment_id String     @id @db.Uuid
  content       Bytes
  attachment    Attachment @relation(fields: [attachment_id], references: [id], onDelete: Cascade)

  @@map("attachment_blobs")
}

model Asset {
  id          String   @id @default(uuid()) @db.Uuid
  bucket      String
  path        String
  public_url  String
  file_name   String?
  mime_type   String?
  data_base64 String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([bucket, path])
  @@map("assets")
}

/// Traccia delle operazioni sensibili: chi ha fatto cosa, su quale club,
/// con quale esito. Vedi ADR-0019 e docs/knowledge-base/14-security.md.
///
/// Non deve mai contenere password, hash, token, codici OTP o credenziali:
/// `recordAuditEvent` filtra i metadati prima di scrivere.
model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  action          String
  outcome         String   @default("success")
  actor_user_id   String?  @db.Uuid
  actor_email     String?
  actor_role      String?
  organization_id String?  @db.Uuid
  resource        String?
  resource_id     String?
  ip              String?
  user_agent      String?
  metadata        Json?
  created_at      DateTime @default(now())

  @@index([organization_id, created_at])
  @@index([actor_user_id, created_at])
  @@index([action, created_at])
  @@index([created_at])
  @@map("audit_logs")
}

/// Un modulo — Modulistica V2 (ADR-0039, ADR-0040).
///
/// Prima di questa tabella un modulo era un oggetto dentro
/// `clubs.document_templates`, insieme ai modelli di stampa e alle risposte
/// gia raccolte. Salvare una risposta riscriveva l'intero array del club, e
/// trovare il modulo di uno slug pubblico voleva dire un `@>` su tutta la
/// tabella `clubs`.
///
/// `draft` e cio che si sta modificando; cio che il pubblico compila e sempre
/// una riga di `form_template_versions`. Le due cose sono separate perche
/// modificare un modulo gia in uso non deve cambiare il significato delle
/// risposte gia arrivate.
///
/// `public_enabled` non e lo stato: e la distribuzione. Un modulo pubblicato
/// ma non pubblico si compila dalla segreteria e il suo link risponde 404.
model FormTemplate {
  id                String                @id @default(uuid()) @db.Uuid
  organization_id   String                @db.Uuid
  title             String
  description       String?
  /// `draft` | `published` | `archived`
  status            String                @default("draft")
  /// Slug leggibile piu dodici caratteri esadecimali: non si indovina a mano.
  public_slug       String                @unique
  public_enabled    Boolean               @default(true)
  draft             Json
  /// Numero dell'ultima versione pubblicata. Zero se non lo e mai stato.
  published_version Int                   @default(0)
  published_at      DateTime?
  created_by        String?               @db.Uuid
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt
  organization      Club                  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  versions          FormTemplateVersion[]
  submissions       FormSubmission[]

  @@index([organization_id, status])
  @@map("form_templates")
}

/// Una versione pubblicata: immutabile.
///
/// Non si aggiorna mai. E l'unica risposta possibile a «con quali domande e
/// stato compilato questo modulo?» che resti vera dopo che il modulo e stato
/// modificato — e i moduli si modificano, tutti gli anni, a stagione aperta.
model FormTemplateVersion {
  id              String           @id @default(uuid()) @db.Uuid
  organization_id String           @db.Uuid
  template_id     String           @db.Uuid
  version         Int
  /// Titolo, descrizione, campi e impostazioni, nella forma di `FormSchema`.
  schema_json     Json
  published_at    DateTime         @default(now())
  published_by    String?          @db.Uuid
  template        FormTemplate     @relation(fields: [template_id], references: [id], onDelete: Cascade)
  submissions     FormSubmission[]

  @@unique([template_id, version])
  @@index([organization_id])
  @@map("form_template_versions")
}

/// Una compilazione.
///
/// **Non e un dato ufficiale.** Nessuna riga di questa tabella modifica da
/// sola l'anagrafica: la segreteria vede la proposta, la confronta con cio
/// che c'e gia e approva. Solo l'approvazione scrive.
///
/// `version_id` cita la versione con cui e stata compilata. Un modulo con
/// compilazioni non si cancella — si archivia — proprio perche quella
/// citazione deve restare risolvibile.
model FormSubmission {
  id               String              @id @default(uuid()) @db.Uuid
  organization_id  String              @db.Uuid
  template_id      String              @db.Uuid
  version_id       String              @db.Uuid
  /// `public` | `internal`
  source           String              @default("public")
  /// `pending` | `approved` | `rejected`
  status           String              @default("pending")
  /// Quale atleta, quale genitore: `FormSubjectSelection[]`.
  subjects         Json
  answers          Json
  /// Metadati degli allegati caricati: riferimenti, mai byte.
  files            Json
  respondent_name  String?
  respondent_email String?
  submitted_by     String?             @db.Uuid
  submitted_at     DateTime            @default(now())
  reviewed_by      String?             @db.Uuid
  reviewed_at      DateTime?
  review_note      String?
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt
  organization     Club                @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  template         FormTemplate        @relation(fields: [template_id], references: [id], onDelete: Cascade)
  template_version FormTemplateVersion @relation(fields: [version_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status])
  @@index([organization_id, template_id, submitted_at])
  @@map("form_submissions")
}

/**
 * ==========================================================================
 * Blocco D — Stripe Connect, billing di piattaforma e motore fiscale.
 * Vedi ADR-0049, ADR-0050, ADR-0051, ADR-0052, ADR-0053.
 * ==========================================================================
 */

/// Una **configurazione della piattaforma**: chiave, valore, chi l'ha scritta.
///
/// **Perche non `clubs.settings`.** Cio che sta in `clubs.settings` lo scrive
/// il club — e il difetto che ADR-0048 ha dovuto chiudere a mano con una lista
/// di chiavi protette. Le condizioni commerciali di EasyGame, gli
/// identificativi Stripe di piattaforma e la scelta del provider fiscale non
/// appartengono a nessun club: stanno in una tabella che nessuna rotta di club
/// sa scrivere.
///
/// **Cosa non c'e qui: i segreti.** Le chiavi Stripe restano variabili
/// d'ambiente. Una chiave segreta in una tabella si legge da qualunque query e
/// finisce in qualunque backup. Qui stanno gli **identificativi** — ambiente,
/// id dei prezzi, tipo di account Connect — che sono configurazione, non
/// credenziali.
model PlatformSetting {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  value      Json
  updated_by String?  @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("platform_settings")
}

/// Una **condizione commerciale**, con la sua data di decorrenza.
///
/// **Perche una riga per versione e non un campo che si sovrascrive.** La
/// commissione di EasyGame cambia: per listino, per trattativa, per singolo
/// cliente. Se il valore corrente fosse l'unico esistente, il giorno in cui
/// passa dall'1% all'1,5% ogni incasso gia registrato verrebbe riletto con la
/// percentuale nuova, e la contabilita del mese scorso cambierebbe da sola.
///
/// Questa tabella conserva **le decisioni**; la commissione effettivamente
/// applicata a un incasso resta comunque congelata sull'incasso stesso
/// (`payment_transactions.platform_fee_cents`). Sono due difese diverse contro
/// lo stesso errore e servono entrambe: la prima spiega *perche* quel numero,
/// la seconda garantisce che *quel* numero non cambi.
///
/// `organization_id` nullo e la regola predefinita di EasyGame; valorizzato, e
/// l'override di un club. Vedi ADR-0050.
model PlatformCommissionRule {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String?  @db.Uuid
  /// Percentuale sull'importo lordo. `1` = 1%.
  percent         Float
  /// Quota fissa in centesimi, se il modello la prevede.
  fixed_cents     Int      @default(0)
  /// Da quando vale. Una regola futura si puo scrivere oggi.
  effective_from  DateTime
  /// Perche e stata decisa. Si rilegge mesi dopo.
  note            String?
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now())
  organization    Club?    @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, effective_from])
  @@index([effective_from])
  @@map("platform_commission_rules")
}

/// L'**account del club presso il PSP**: cio che Stripe dice, non cio che il
/// club dichiara.
///
/// **Perche esce da `clubs.settings`.** Finche l'identificativo dell'account
/// connesso stava in un campo scrivibile dalla pagina Organizzazione, una
/// societa poteva digitarci l'account di chiunque e selezionare «attivo» da un
/// menu a tendina: gli incassi delle famiglie sarebbero finiti su un conto
/// scelto dal club, con EasyGame a fare da tramite. Qui lo scrivono due sole
/// cose — la console di piattaforma e l'evento `account.updated` firmato da
/// Stripe.
///
/// `online_payments_enabled` e l'interruttore **commerciale**, e lo tiene Cedi
/// Soft. E diverso da «il club ha spento i pagamenti nelle sue impostazioni»,
/// che resta una preferenza del club: uno dei due sospende un servizio,
/// l'altro e una scelta operativa.
model ClubPaymentAccount {
  id                         String    @id @default(uuid()) @db.Uuid
  organization_id            String    @unique @db.Uuid
  provider                   String    @default("stripe")
  /// `acct_...`. Lo restituisce il PSP: nessun essere umano lo digita.
  external_account_id        String?
  /// `standard` o `express`. Scelta **irreversibile** per account: vedi ADR-0051.
  account_type               String    @default("standard")
  /// Vedi `CONNECT_ACCOUNT_STATES` in `src/lib/payments/connect-account.ts`.
  status                     String    @default("not_configured")
  charges_enabled            Boolean   @default(false)
  payouts_enabled            Boolean   @default(false)
  /// Cosa manca perche l'account diventi operativo, in parole di Stripe.
  requirements               Json?
  disabled_reason            String?
  /// L'interruttore della piattaforma. Il club non lo tocca.
  online_payments_enabled    Boolean   @default(false)
  /// **Quando l'interruttore e stato deciso davvero.** `null` significa che
  /// nessuno lo ha mai mosso: il `false` accanto e il default della colonna,
  /// non una scelta. Senza questa distinzione un club con l'account Stripe
  /// attivo restava «pagamenti non attivi» per sempre, perche il ramo di
  /// aggiornamento non toccava l'interruttore; e risolverla con un `true`
  /// indiscriminato avrebbe riacceso gli incassi di una societa sospesa di
  /// proposito. Vedi `resolvePlatformEnablement` e ADR-0064.
  online_payments_decided_at DateTime?
  last_synced_at             DateTime?
  last_error                 String?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt
  organization               Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([external_account_id])
  @@map("club_payment_accounts")
}

/// L'**abbonamento EasyGame** di una societa: il flusso Cedi Soft -> Club.
///
/// **Perche non e la tabella degli incassi degli atleti.** Sono due denari
/// diversi su due account Stripe diversi: la quota che una societa paga a Cedi
/// Soft entra sull'account **centrale** di Cedi Soft; la quota che una famiglia
/// paga entra sull'account **connesso del club**. Mescolarle vorrebbe dire che
/// il fatturato di EasyGame compare nel registro incassi di un club, e che il
/// registro incassi di un club compare nel fatturato di EasyGame. Vedi
/// ADR-0051.
model PlatformBillingAccount {
  id                       String    @id @default(uuid()) @db.Uuid
  organization_id          String    @unique @db.Uuid
  provider                 String    @default("stripe")
  external_customer_id     String?
  external_subscription_id String?
  external_price_id        String?
  /// `free` o `plus`: lo stesso vocabolario degli entitlement.
  plan                     String    @default("free")
  /// `not_active` | `trialing` | `active` | `past_due` | `cancelled` | `expired`
  status                   String    @default("not_active")
  current_period_end       DateTime?
  cancel_at_period_end     Boolean   @default(false)
  last_event_at            DateTime?
  last_error               String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  organization             Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([external_customer_id])
  @@index([external_subscription_id])
  @@map("platform_billing_accounts")
}

/// Il **profilo fiscale** di un'organizzazione.
///
/// **Perche non basta l'anagrafica del club.** L'anagrafica risponde a «come si
/// chiama e dove ha sede»; questa risponde a «che soggetto e davanti al fisco».
/// Sono due domande diverse e cambiano in momenti diversi: una societa cambia
/// indirizzo di corrispondenza senza cambiare forma giuridica, e cambia regime
/// senza traslocare.
///
/// **Perche la forma giuridica non decide il trattamento fiscale.** Due ASD
/// possono avere trattamenti diversi — una in regime 398, una no; una con
/// partita IVA per l'attivita commerciale, una senza. Dedurre l'IVA dalla sigla
/// produrrebbe documenti sbagliati con l'aria di essere giusti. Qui la sigla si
/// **registra**; cosa comporti lo dice la configurazione, e chi la configura se
/// ne assume la responsabilita. Vedi ADR-0052.
model OrganizationFiscalProfile {
  id                   String    @id @default(uuid()) @db.Uuid
  organization_id      String    @unique @db.Uuid
  /// Ragione sociale come compare sui documenti. Puo differire dal nome d'uso.
  legal_name           String?
  /// Vedi `LEGAL_FORMS` in `src/lib/fiscal/legal-forms.ts`.
  legal_form           String    @default("altro")
  fiscal_code          String?
  vat_number           String?
  /// Codice regime fiscale (`RF01`, `RF19`, ...): una codifica, non una conclusione.
  tax_regime_code      String?
  /// Regimi speciali dichiarati (per esempio L. 398/1991). Mai dedotti dalla sigla.
  special_regimes      Json?
  address              String?
  city                 String?
  province             String?
  postal_code          String?
  country              String    @default("IT")
  /// Codice catastale del comune, dall'archivio ISTAT gia presente in EasyGame.
  city_code            String?
  pec                  String?
  /// Codice destinatario SdI del **soggetto emittente**, quando ne ha uno.
  recipient_code       String?
  rea_office           String?
  rea_number           String?
  rea_capital          Float?
  rea_sole_shareholder Boolean?
  rea_in_liquidation   Boolean?
  /// Imposta di bollo: soglia, importo, a carico di chi. Configurazione.
  stamp_duty           Json?
  /// Impostazioni fiscali ulteriori, dichiarate.
  settings             Json?
  /// Quando il profilo e stato dichiarato completo da chi lo governa.
  completed_at         DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  organization         Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("organization_fiscal_profiles")
}

/// Una **serie di numerazione** dei documenti di un club.
///
/// **Perche una tabella e non un campo.** Una societa che emette ricevute per
/// le quote e fatture per le sponsorizzazioni tiene due registri con due
/// progressioni: metterli nella stessa serie li mescola, e un registro
/// mescolato non si riconcilia piu. `is_default` esiste perche la stragrande
/// maggioranza dei club ne ha **una** e non deve accorgersi che il concetto
/// esista.
model DocumentSeries {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  /// `receipt` | `invoice` | `credit_note`
  kind            String
  /// Il codice della serie. Vuoto = serie predefinita, senza suffisso.
  code            String   @default("")
  label           String
  /// Il prefisso che compare nel numero: `R`, `FT`, `NC`.
  prefix          String
  is_default      Boolean  @default(false)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Club     @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, kind, code])
  @@index([organization_id, kind])
  @@map("document_series")
}

/// Il **tipo di operazione** economica: cosa si sta incassando.
///
/// **Perche la classificazione e configurazione.** «Quota associativa» e
/// «vendita di abbigliamento» non hanno lo stesso trattamento, ma quale
/// trattamento abbiano dipende dal soggetto e dal suo regime — non da una
/// tabella scritta dentro il codice di un gestionale. Qui si dichiara l'elenco
/// delle operazioni del club e, per ognuna, cosa il club ha deciso che
/// comporti. EasyGame **propone** il percorso documentale; non lo stabilisce al
/// posto di un commercialista. Vedi ADR-0052.
model FiscalOperationType {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  code            String
  label           String
  /// `none` | `receipt` | `invoice` | `invoice_or_receipt`
  document_route  String   @default("receipt")
  /// Aliquota IVA, quando configurata. `null` = non dichiarata.
  vat_rate        Float?
  /// Natura IVA (`N2.2`, `N4`, ...) quando l'operazione non e imponibile.
  vat_nature      String?
  /// `institutional` | `commercial` | `unspecified`. Lo dichiara chi configura.
  activity_scope  String   @default("unspecified")
  is_active       Boolean  @default(true)
  /// Vero per le voci del catalogo predefinito: si disattivano, non si cancellano.
  is_system       Boolean  @default(false)
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Club     @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, code])
  @@index([organization_id])
  @@map("fiscal_operation_types")
}

/// La **trasmissione** di una fattura allo SdI: un oggetto separato dalla
/// fattura.
///
/// **Perche separata.** Una fattura esiste, e valida ed e numerata anche se non
/// e mai stata trasmessa; una trasmissione puo fallire, essere scartata e
/// ripetuta senza che la fattura cambi. Tenere lo stato di trasmissione dentro
/// la fattura vorrebbe dire che «scartata dallo SdI» diventa uno stato del
/// documento — e non lo e.
///
/// **In questo rilascio la trasmissione non e attiva.** Non e stato scelto un
/// intermediario accreditato: EasyGame prepara e valida, non invia, e `status`
/// non puo superare `ready_to_send`. Marcare «inviata» una fattura che non e
/// transitata dallo SdI farebbe credere a una societa di aver adempiuto. Vedi
/// ADR-0053.
model EInvoiceTransmission {
  id                String    @id @default(uuid()) @db.Uuid
  organization_id   String    @db.Uuid
  invoice_id        String    @unique @db.Uuid
  /// La chiave dell'intermediario, quando ce ne sara uno. Oggi sempre `null`.
  provider          String?
  /// Vedi `EINVOICE_STATES` in `src/lib/fiscal/fatturapa/states.ts`.
  status            String    @default("draft")
  format            String    @default("FPR12")
  /// Il nome del file secondo la convenzione SdI: `IT01234567890_00001.xml`.
  file_name         String?
  /// L'XML preparato. La sua esistenza non significa che sia stato inviato.
  payload           String?
  payload_hash      String?
  /// Cosa impedisce la trasmissione, in italiano, campo per campo.
  validation_errors Json?
  /// L'identificativo assegnato dallo SdI. Nullo finche non trasmette davvero.
  sdi_identifier    String?
  /// Le ricevute dello SdI, come sono arrivate. Mai inventate.
  sdi_receipts      Json?
  transmitted_at    DateTime?
  last_error        String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  organization      Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  invoice           Invoice   @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([organization_id, status])
  @@map("einvoice_transmissions")
}

/// ---------------------------------------------------------------------------
/// Lavoro sportivo e compensi (WP Sport Work V1).
///
/// Undici tabelle, ognuna per una domanda diversa. Il dominio e **isolato**:
/// non tocca `payments`, `payment_transactions` ne `trainer_payments`. Un
/// compenso a un allenatore non e un incasso da una famiglia, e forzarlo
/// dentro il registro delle entrate produrrebbe la stessa confusione che
/// ADR-0037 ha gia evitato fra contributi e pagamenti.
/// ---------------------------------------------------------------------------

/// La **persona** del modulo: l'identita canonica di chi lavora per il club.
///
/// Esiste perche allenatori e staff, in EasyGame, non sono righe di tabella:
/// stanno in `clubs.trainers` e `clubs.staff_members`, colonne JSON. Un
/// rapporto di lavoro che deve puntare a una persona con integrita
/// referenziale, li, non ce l'ha. `origin_type` + `origin_id` dichiarano da
/// dove viene la persona; il legame e **debole** di proposito, perche un
/// contratto firmato non si cancella insieme a una scheda.
///
/// Nome, cognome, codice fiscale, nascita, contatti e IBAN stanno **qui e una
/// volta sola**: e il punto del Person Core.
model SportWorkPerson {
  id              String                          @id @default(uuid()) @db.Uuid
  organization_id String                          @db.Uuid
  /// athlete | trainer | staff_member | member | user | external
  origin_type     String                          @default("external")
  /// Identificativo nell'anagrafica di origine. Testo: gli allenatori JSON non hanno UUID.
  origin_id       String?
  first_name      String
  last_name       String
  fiscal_code     String?
  birth_date      DateTime?
  birth_place     String?
  gender          String?
  email           String?
  phone           String?
  address         String?
  /// NONE | VAT_ORDINARY | VAT_FLAT_RATE
  fiscal_profile  String                          @default("NONE")
  vat_number      String?
  pension_fund    String?
  /// NONE | OTHER_COVERAGE | PENSIONER — decide l'aliquota. **Dichiarata, non dedotta.**
  social_coverage String                          @default("NONE")
  /// Dato riservato: non compare mai nelle proiezioni di elenco.
  iban            String?
  notes           String?
  data            Json?
  created_by      String?                         @db.Uuid
  created_at      DateTime                        @default(now())
  updated_at      DateTime                        @updatedAt
  organization    Club                            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  relationships   SportWorkRelationship[]
  declarations    SportWorkExternalDeclaration[]
  year_positions  SportWorkYearPosition[]
  transactions    SportWorkOutboundTransaction[]
  bonuses         SportWorkBonus[]
  reimbursements  SportWorkExpenseReimbursement[]
  vat_invoices    SportWorkVatInvoice[]
  obligations     SportWorkObligation[]

  @@index([organization_id])
  @@index([organization_id, origin_type, origin_id])
  @@map("sport_work_people")
}

/// Il **rapporto di lavoro sportivo**: una persona, un club, un periodo, un
/// tipo e uno stato.
///
/// `season_id` esiste per l'operativita — quali contratti ho per la stagione
/// in corso — ma **non e la chiave del motore**: il calcolo e la posizione
/// appartengono all'anno solare, e metterli nello stesso perimetro
/// azzererebbe i progressivi cambiando stagione, cioe a giugno.
model SportWorkRelationship {
  id                     String                          @id @default(uuid()) @db.Uuid
  organization_id        String                          @db.Uuid
  person_id              String                          @db.Uuid
  season_id              String?
  /// ATHLETE | COACH | INSTRUCTOR | ... (vedi src/lib/sport-work/model.ts)
  role                   String                          @default("OTHER")
  /// SPORT_COCOCO | SELF_EMPLOYED_VAT | EXTERNAL_PAYROLL_REFERENCE
  relationship_type      String                          @default("SPORT_COCOCO")
  start_date             DateTime
  end_date               DateTime?
  /// DRAFT | ACTIVE | SUSPENDED | EXPIRED | TERMINATED
  status                 String                          @default("DRAFT")
  contract_amount        Float?
  currency               String                          @default("EUR")
  /// SEASONAL | ANNUAL | MONTHLY | PER_PERFORMANCE
  compensation_frequency String                          @default("SEASONAL")
  /// Ore settimanali dichiarate: serve alla presunzione delle 24 ore (art. 28).
  weekly_hours           Float?
  contract_attachment_id String?                         @db.Uuid
  /// NOT_REQUIRED | PENDING | SIGNED
  signature_state        String                          @default("NOT_REQUIRED")
  /// NOT_REQUIRED | TO_PREPARE | READY | SUBMITTED | CONFIRMED | ERROR
  rasd_status            String                          @default("TO_PREPARE")
  rasd_reference         String?
  rasd_communicated_at   DateTime?
  rasd_notes             String?
  terminated_at          DateTime?
  termination_reason     String?
  notes                  String?
  data                   Json?
  created_by             String?                         @db.Uuid
  created_at             DateTime                        @default(now())
  updated_at             DateTime                        @updatedAt
  organization           Club                            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  person                 SportWorkPerson                 @relation(fields: [person_id], references: [id], onDelete: Cascade)
  plan                   SportWorkCompensationPlan?
  installments           SportWorkInstallment[]
  transactions           SportWorkOutboundTransaction[]
  bonuses                SportWorkBonus[]
  reimbursements         SportWorkExpenseReimbursement[]
  vat_invoices           SportWorkVatInvoice[]
  obligations            SportWorkObligation[]

  @@index([organization_id])
  @@index([organization_id, status])
  @@index([person_id])
  @@map("sport_work_relationships")
}

/// Il **piano compensi** di un rapporto. Uno per rapporto: rivederlo significa
/// rigenerarne le scadenze, e una rata gia erogata non si rigenera.
model SportWorkCompensationPlan {
  id              String                 @id @default(uuid()) @db.Uuid
  organization_id String                 @db.Uuid
  relationship_id String                 @unique @db.Uuid
  /// EQUAL_INSTALMENTS | MONTHLY | CUSTOM
  kind            String                 @default("EQUAL_INSTALMENTS")
  total_amount    Float                  @default(0)
  currency        String                 @default("EUR")
  /// La configurazione che ha generato le rate: numero, mese iniziale, importi.
  config          Json?
  notes           String?
  created_by      String?                @db.Uuid
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt
  organization    Club                   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  relationship    SportWorkRelationship  @relation(fields: [relationship_id], references: [id], onDelete: Cascade)
  installments    SportWorkInstallment[]

  @@index([organization_id])
  @@map("sport_work_compensation_plans")
}

/// Una **scadenza** del piano.
///
/// `gross_amount`, `accrued_amount` e `paid_amount` sono tre grandezze diverse
/// — programmato, maturato, erogato — e `status` si **deriva** da loro.
/// Nessuna schermata lo imposta.
///
/// `fiscal_year` qui e l'anno **della scadenza programmata**: una previsione.
/// L'anno fiscale che conta e quello della data di pagamento, e sta sulla riga
/// del registro in uscita.
model SportWorkInstallment {
  id                   String                         @id @default(uuid()) @db.Uuid
  organization_id      String                         @db.Uuid
  plan_id              String                         @db.Uuid
  relationship_id      String                         @db.Uuid
  sequence             Int
  label                String
  accrual_period_start DateTime
  accrual_period_end   DateTime
  due_date             DateTime
  gross_amount         Float
  accrued_amount       Float                          @default(0)
  paid_amount          Float                          @default(0)
  remaining_amount     Float                          @default(0)
  /// SCHEDULED | ACCRUED | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  status               String                         @default("SCHEDULED")
  /// Anno solare della scadenza programmata. Non l'anno fiscale dell'erogazione.
  fiscal_year          Int
  cancelled            Boolean                        @default(false)
  notes                String?
  created_at           DateTime                       @default(now())
  updated_at           DateTime                       @updatedAt
  organization         Club                           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  plan                 SportWorkCompensationPlan      @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  relationship         SportWorkRelationship          @relation(fields: [relationship_id], references: [id], onDelete: Cascade)
  transactions         SportWorkOutboundTransaction[]

  @@unique([plan_id, sequence])
  @@index([organization_id])
  @@index([organization_id, due_date])
  @@index([relationship_id])
  @@map("sport_work_compensation_installments")
}

/// Il **registro in uscita**: l'unica scrittura di denaro del dominio.
///
/// Append-only. Non esiste `DELETE`: correggere significa aggiungere una riga
/// di segno opposto (`COMPENSATION_REVERSAL`) che compensa l'originale, e
/// l'originale resta marcato `reversed_at`. E la stessa disciplina del
/// registro degli incassi (ADR-0036), applicata al denaro che esce.
///
/// I valori del calcolo sono **congelati** sulla riga: `rules_version`,
/// aliquota, riduzione, imponibili e quote. Una modifica normativa futura non
/// riscrive la storia, perche la storia se la porta dietro.
model SportWorkOutboundTransaction {
  id                    String                 @id @default(uuid()) @db.Uuid
  organization_id       String                 @db.Uuid
  /// COMPENSATION_PAYMENT | COMPENSATION_REVERSAL | BONUS_PAYMENT | ...
  transaction_type      String                 @default("COMPENSATION_PAYMENT")
  person_id             String                 @db.Uuid
  relationship_id       String?                @db.Uuid
  installment_id        String?                @db.Uuid
  bonus_id              String?                @db.Uuid
  reimbursement_id      String?                @db.Uuid
  vat_invoice_id        String?                @db.Uuid
  paid_at               DateTime
  /// Anno solare della data di pagamento: le franchigie si consumano per cassa.
  fiscal_year           Int
  gross_amount          Float
  currency              String                 @default("EUR")
  payment_method        String?
  reference             String?
  bank_account_id       String?
  /// L'anno del rule set che ha prodotto i numeri di questa riga.
  rules_version         String?
  social_rate           Float                  @default(0)
  reduction_factor      Float                  @default(0)
  taxable_social        Float                  @default(0)
  social_franchise_used Float                  @default(0)
  employee_contribution Float                  @default(0)
  employer_contribution Float                  @default(0)
  taxable_fiscal        Float                  @default(0)
  fiscal_franchise_used Float                  @default(0)
  /// Sempre NULL in V1: EasyGame non determina la ritenuta IRPEF.
  withholding_amount    Float?
  net_amount            Float                  @default(0)
  club_cost             Float                  @default(0)
  f24_causale           String?
  /// NOT_APPLICABLE | TO_VERIFY | OUT_OF_SCOPE
  fiscal_treatment      String                 @default("NOT_APPLICABLE")
  /// Falso se una regola usata dal calcolo non e validata.
  definitive            Boolean                @default(true)
  /// Lo snapshot completo: soglie, aliquote, fonti, voci pendenti.
  fiscal_snapshot       Json?
  reversal_of_id        String?                @db.Uuid
  reversed_at           DateTime?
  reversal_reason       String?
  /// Chiave dell'operazione, per rifiutare il doppio invio dello stesso gesto.
  idempotency_key       String?
  notes                 String?
  created_by            String?                @db.Uuid
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  organization          Club                   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  person                SportWorkPerson        @relation(fields: [person_id], references: [id], onDelete: Cascade)
  relationship          SportWorkRelationship? @relation(fields: [relationship_id], references: [id], onDelete: SetNull)
  installment           SportWorkInstallment?  @relation(fields: [installment_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([organization_id, paid_at])
  @@index([organization_id, person_id, fiscal_year])
  @@index([installment_id])
  @@index([reversal_of_id])
  @@map("sport_work_outbound_transactions")
}

/// L'**autocertificazione dei compensi esterni**: un record, non un allegato.
///
/// Le soglie sono del lavoratore e non del committente: senza questa
/// dichiarazione il progressivo e strutturalmente parziale. Il suo valore
/// principale non e la precisione del netto — e **provare cosa il club sapeva
/// quando**, con una data e una firma.
model SportWorkExternalDeclaration {
  id                 String          @id @default(uuid()) @db.Uuid
  organization_id    String          @db.Uuid
  person_id          String          @db.Uuid
  fiscal_year        Int
  external_amount    Float           @default(0)
  declaration_date   DateTime
  effective_from     DateTime?
  attachment_id      String?         @db.Uuid
  /// ACTIVE | SUPERSEDED | REVOKED
  status             String          @default("ACTIVE")
  /// Vero se il lavoratore dichiara di avere altra copertura previdenziale.
  has_other_coverage Boolean         @default(false)
  supersedes_id      String?         @db.Uuid
  notes              String?
  data               Json?
  created_by         String?         @db.Uuid
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  organization       Club            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  person             SportWorkPerson @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([organization_id, person_id, fiscal_year])
  @@map("sport_work_external_declarations")
}

/// La **posizione annua**: derivata dal registro e dalla dichiarazione, e
/// materializzata perche mezza applicazione la legge.
///
/// Nessuna schermata la scrive. La riscrive il servizio, ricalcolandola dal
/// registro dopo ogni erogazione, ogni storno e ogni dichiarazione nuova.
model SportWorkYearPosition {
  id                      String          @id @default(uuid()) @db.Uuid
  organization_id         String          @db.Uuid
  person_id               String          @db.Uuid
  year                    Int
  club_gross              Float           @default(0)
  external_declared       Float           @default(0)
  progressive             Float           @default(0)
  social_franchise_used   Float           @default(0)
  social_taxable          Float           @default(0)
  employee_contribution   Float           @default(0)
  employer_contribution   Float           @default(0)
  fiscal_franchise_used   Float           @default(0)
  fiscal_taxable          Float           @default(0)
  withheld                Float           @default(0)
  payment_count           Int             @default(0)
  last_payment_at         DateTime?
  last_declaration_at     DateTime?
  has_current_declaration Boolean         @default(false)
  computed_at             DateTime
  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt
  organization            Club            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  person                  SportWorkPerson @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, person_id, year])
  @@index([organization_id, year])
  @@map("sport_work_year_positions")
}

/// Un **premio**: somma per un risultato, non per la prestazione.
///
/// Tabella a se e non un tipo di rata, perche il suo trattamento fiscale e
/// diverso e **non e validato**: sommarlo al compenso renderebbe falso — in
/// eccesso — il progressivo verso le soglie.
model SportWorkBonus {
  id               String                 @id @default(uuid()) @db.Uuid
  organization_id  String                 @db.Uuid
  person_id        String                 @db.Uuid
  relationship_id  String?                @db.Uuid
  reason           String
  competition      String?
  amount           Float
  currency         String                 @default("EUR")
  award_date       DateTime
  payment_date     DateTime?
  /// TO_VERIFY | PRIZE_ART_36 | VARIABLE_REMUNERATION — **dichiarato, non dedotto**.
  fiscal_treatment String                 @default("TO_VERIFY")
  /// SCHEDULED | PAID | CANCELLED
  status           String                 @default("SCHEDULED")
  paid_amount      Float                  @default(0)
  notes            String?
  created_by       String?                @db.Uuid
  created_at       DateTime               @default(now())
  updated_at       DateTime               @updatedAt
  organization     Club                   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  person           SportWorkPerson        @relation(fields: [person_id], references: [id], onDelete: Cascade)
  relationship     SportWorkRelationship? @relation(fields: [relationship_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([person_id])
  @@map("sport_work_bonuses")
}

/// Un **rimborso spese**. Non e un compenso: non concorre a nessuna soglia e
/// non entra nel progressivo.
model SportWorkExpenseReimbursement {
  id              String                 @id @default(uuid()) @db.Uuid
  organization_id String                 @db.Uuid
  person_id       String                 @db.Uuid
  relationship_id String?                @db.Uuid
  /// TRAVEL | MEALS | ACCOMMODATION | MILEAGE | OTHER_DOCUMENTED
  category        String                 @default("OTHER_DOCUMENTED")
  description     String
  expense_date    DateTime
  amount          Float
  currency        String                 @default("EUR")
  /// DRAFT | SUBMITTED | APPROVED | REJECTED | PAID
  status          String                 @default("DRAFT")
  approved_by     String?                @db.Uuid
  approved_at     DateTime?
  rejected_reason String?
  paid_amount     Float                  @default(0)
  notes           String?
  created_by      String?                @db.Uuid
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt
  organization    Club                   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  person          SportWorkPerson        @relation(fields: [person_id], references: [id], onDelete: Cascade)
  relationship    SportWorkRelationship? @relation(fields: [relationship_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([person_id])
  @@map("sport_work_expense_reimbursements")
}

/// Una **fattura ricevuta** da un professionista con partita IVA.
///
/// Documento **in entrata** per il club: il calcolo lo ha fatto chi l'ha
/// emessa, e il club registra numero, data, importi, scadenza e pagamento.
/// Nessuna regola co.co.co. la tocca.
model SportWorkVatInvoice {
  id                 String                 @id @default(uuid()) @db.Uuid
  organization_id    String                 @db.Uuid
  person_id          String                 @db.Uuid
  relationship_id    String?                @db.Uuid
  document_number    String
  document_date      DateTime
  taxable_amount     Float                  @default(0)
  vat_amount         Float                  @default(0)
  /// Ritenuta indicata **in fattura** dal professionista. EasyGame non la calcola.
  withholding_amount Float                  @default(0)
  total_amount       Float
  currency           String                 @default("EUR")
  due_date           DateTime?
  /// PENDING | PARTIALLY_PAID | PAID | CANCELLED
  status             String                 @default("PENDING")
  paid_amount        Float                  @default(0)
  attachment_id      String?                @db.Uuid
  notes              String?
  created_by         String?                @db.Uuid
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt
  organization       Club                   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  person             SportWorkPerson        @relation(fields: [person_id], references: [id], onDelete: Cascade)
  relationship       SportWorkRelationship? @relation(fields: [relationship_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([person_id])
  @@map("sport_work_vat_invoices")
}

/// L'**agenda degli adempimenti**.
///
/// `reference_key` e la chiave di idempotenza: `f24:2026-09`, `rasd:<id>`,
/// `cu:<persona>:2026`. Rieseguire la derivazione non crea una seconda riga
/// per la stessa scadenza, e quindi non produce una seconda notifica.
model SportWorkObligation {
  id                     String                 @id @default(uuid()) @db.Uuid
  organization_id        String                 @db.Uuid
  /// CONTRIBUTION | F24 | SELF_DECLARATION | CONTRACT_EXPIRY | RASD_COMMUNICATION | CU_PREPARATION | DOCUMENT_EXPIRY
  kind                   String
  reference_key          String
  person_id              String?                @db.Uuid
  relationship_id        String?                @db.Uuid
  title                  String
  description            String?
  due_date               DateTime
  /// DUE | IN_PROGRESS | COMPLETED | NOT_DUE
  status                 String                 @default("DUE")
  amount                 Float?
  period                 String?
  /// derived | manual
  source                 String                 @default("derived")
  completed_by           String?                @db.Uuid
  completed_at           DateTime?
  evidence_attachment_id String?                @db.Uuid
  /// Quando e partita la notifica: la seconda esecuzione dello scheduler non la ripete.
  notified_at            DateTime?
  notes                  String?
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  organization           Club                   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  person                 SportWorkPerson?       @relation(fields: [person_id], references: [id], onDelete: SetNull)
  relationship           SportWorkRelationship? @relation(fields: [relationship_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, reference_key])
  @@index([organization_id, status, due_date])
  @@map("sport_work_obligations")
}

/// Il **registro delle consegne**: l'unica fonte di verita su cosa e uscito
/// dal gestionale verso una persona (Wave 2, ADR-0084).
///
/// **Perche una tabella sola per quattro sorgenti.** Prima della Wave 2
/// convivevano tre dialetti di deduplica — `data.sportWorkKey` (per sempre),
/// `data.key` con finestra di sette giorni, e una rivendicazione dentro
/// `athletes.data.paymentReminders` con finestra di sei ore — e nessuno di
/// loro sapeva rispondere a «chi ha ricevuto cosa». Sono la stessa domanda
/// posta due volte: «gli ho gia scritto?» e «cosa gli ho scritto?» si
/// rispondono con la stessa riga.
///
/// **`recipient_key` e l'indirizzo, non l'account.** Un tutore senza account
/// non ha un id, e la stessa email puo rappresentare due atleti: la chiave e
/// cio che il messaggio raggiunge davvero. Le persone rappresentate restano
/// tracciate in `athlete_ids`, cosi un messaggio unico non perde per chi era.
///
/// **L'indice unico e la difesa contro il doppione**, non un controllo
/// applicativo: regge anche con due cron in parallelo, che e esattamente il
/// caso in cui un controllo in memoria non regge.
model CommunicationDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  organization_id   String    @db.Uuid
  /// `automation` | `bulk` | `board` | `reminder`
  source_kind       String
  /// La regola, la comunicazione o l'annuncio che l'ha prodotta.
  source_id         String
  /// Deterministica: chi, per cosa, per quale occorrenza.
  dedup_key         String
  /// Email normalizzata in minuscolo, oppure `user:<id>` per il solo in-app.
  recipient_key     String
  recipient_user_id String?   @db.Uuid
  recipient_name    String?
  recipient_email   String?
  /// Le persone a cui il messaggio si riferisce. Un solo messaggio, N posizioni.
  athlete_ids       String[]  @default([])
  /// `email` | `in_app` | `board`
  channel           String
  /// `pending` (rivendicato, invio in corso) | `sent` | `skipped` | `failed`
  status            String
  /// Il motivo, dall'enum chiusa di `src/lib/audience/recipients.ts`.
  reason            String?
  subject           String?
  read_at           DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  organization      Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, dedup_key, recipient_key, channel])
  @@index([organization_id, source_kind, source_id])
  @@index([organization_id, recipient_user_id, read_at])
  @@index([organization_id, created_at])
  @@map("communication_deliveries")
}

/// Un **link di pagamento**: il modo in cui una famiglia paga una rata senza
/// avere un account (Wave 2, G-06, ADR-0085).
///
/// **Il token non e qui.** Qui c'e il suo SHA-256: chi legge il database non
/// ottiene link funzionanti, esattamente come per `code_hash` delle sfide OTP.
/// Il token in chiaro esiste solo nel messaggio alla famiglia.
///
/// **Il token non porta claim.** Trentadue byte casuali non dicono ne il club
/// ne la rata: non c'e niente da manomettere e nessun identificativo interno
/// esposto. L'ambito lo dice questa riga, che e anche cio che rende possibile
/// revocare e tracciare — le due cose per cui un token senza stato avrebbe
/// comunque avuto bisogno di una riga.
///
/// **Non congela nessun importo.** Il residuo si ricalcola al riscatto da
/// `buildInstallmentLedgers`: una famiglia che paga allo sportello e poi apre
/// il link non deve pagare due volte.
model PaymentLink {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  payment_id      String    @db.Uuid
  athlete_id      String?   @db.Uuid
  token_hash      String    @unique
  expires_at      DateTime
  revoked_at      DateTime?
  created_by      String?   @db.Uuid
  last_used_at    DateTime?
  use_count       Int       @default(0)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  organization    Club      @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, payment_id])
  @@index([expires_at])
  @@map("payment_links")
}

/**
 * ==========================================================================
 * Wave 3 — Documenti intelligenti, consensi e scadenze documentali.
 * Vedi docs/knowledge-base/35-wave-3-planning.md e ADR-0088…ADR-0092.
 * ==========================================================================
 */

/// Un **modello di documento** del club.
///
/// **Perche una tabella e non piu l'array JSON** (ADR-0088). Fino alla Wave 3
/// un modello era un oggetto dentro `clubs.document_templates`, scritto in
/// place: nessuna versione, nessun autore attendibile, e due forme diverse
/// nella stessa colonna a seconda che lo scrivesse `/modulistica` o il CRUD
/// generico. Correggere un modello riscriveva **anche** i documenti gia
/// consegnati, perche non ne esisteva una copia.
///
/// E lo stesso problema da cui i moduli online sono usciti con ADR-0039 e
/// ADR-0040, e la forma e la stessa: modello, versioni immutabili, e chi le
/// cita.
///
/// **`clubs.document_templates` non viene svuotata**: la migrazione e una
/// copia, come per i moduli. Vedi il debito `D28`.
model DocumentTemplate {
  id                String                    @id @default(uuid()) @db.Uuid
  organization_id   String                    @db.Uuid
  title             String
  description       String?
  /// Di chi parla il documento: `club` | `athlete` | `person` | `member`.
  ///
  /// Non e una decorazione: e cio che decide quali segnaposto l'editor propone
  /// e quale soggetto il risolutore va a leggere. Un modello che parla di un
  /// atleta e uno che parla di un allenatore non hanno gli stessi dati
  /// disponibili, e fingere di si produce campi bianchi (debito `DOC-04`).
  subject_kind      String                    @default("athlete")
  /// `draft` | `active` | `retired`.
  ///
  /// `retired` non e `deleted`: un modello ritirato non si propone piu per
  /// documenti nuovi, ma **continua a spiegare** quelli gia generati con le
  /// sue versioni. Un modello con documenti generati non si cancella mai.
  status            String                    @default("draft")
  /// Numero dell'ultima versione pubblicata. Zero se non lo e mai stato.
  published_version Int                       @default(0)
  published_at      DateTime?
  /// Da quale voce del catalogo di piattaforma deriva, se deriva da una.
  ///
  /// Serve a due cose: non riproporre al club un modello che ha gia adottato,
  /// e sapere quali copie andrebbero riviste quando la voce di catalogo cambia.
  /// Una copia adottata **e del club**: cambiarla non tocca il catalogo.
  catalog_key       String?
  /// La classe redazionale della voce di catalogo da cui nasce: `A` generic,
  /// `B` federazione/regione, `C` legale/fiscale (ADR-0092).
  ///
  /// Sta sulla riga e non solo nel catalogo perche chi apre il modello fra un
  /// anno deve poter sapere **cosa ha adottato**, anche se la voce di catalogo
  /// nel frattempo e stata ritirata.
  catalog_class     String?
  /// Chi risponde del testo. Per una copia del club e il club stesso.
  editorial_owner   String?
  /// Quando il testo e stato riletto l'ultima volta. Un modello senza questa
  /// data e un modello che nessuno controlla.
  last_reviewed_at  DateTime?
  editorial_notes   String?
  created_by        String?                   @db.Uuid
  created_at        DateTime                  @default(now())
  updated_at        DateTime                  @updatedAt
  organization      Club                      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  versions          DocumentTemplateVersion[]
  generated         GeneratedDocument[]

  @@index([organization_id, status])
  @@index([organization_id, catalog_key])
  @@map("document_templates_v2")
}

/// Una versione pubblicata di un modello: **immutabile**.
///
/// Non si aggiorna mai. E l'unica risposta possibile a «con quale testo e stato
/// rilasciato questo documento?» che resti vera dopo che il modello e stato
/// corretto — e i modelli si correggono, tutti gli anni.
model DocumentTemplateVersion {
  id               String              @id @default(uuid()) @db.Uuid
  organization_id  String              @db.Uuid
  template_id      String              @db.Uuid
  version          Int
  title            String
  content_html     String
  /// I segnaposto che il testo nomina, letti dal testo e non dal catalogo.
  ///
  /// Precalcolati alla pubblicazione perche servono **prima** di generare: a
  /// dire quali dati il modello chiedera, e a decidere se chi genera puo
  /// vederli. Rileggerli dall'HTML a ogni generazione vorrebbe dire analizzare
  /// cento volte lo stesso testo dentro un lotto da cento.
  placeholder_keys String[]            @default([])
  /// Le classi sensibili presenti fra quei segnaposto: `economic`, `health`.
  ///
  /// E la chiave del controllo di permesso, e sta qui perche e una proprieta
  /// **della versione**: una correzione che aggiunge un importo cambia chi puo
  /// generare quel modello, e deve farlo dal momento della pubblicazione.
  sensitivity      String[]            @default([])
  subject_kind     String
  published_at     DateTime            @default(now())
  published_by     String?             @db.Uuid
  template         DocumentTemplate    @relation(fields: [template_id], references: [id], onDelete: Cascade)
  generated        GeneratedDocument[]

  @@unique([template_id, version])
  @@index([organization_id])
  @@map("document_template_versions")
}

/// Un **documento generato**: il fatto, non il file.
///
/// **Perche non e un allegato** (ADR-0089). `GET /api/v1/attachments/:id`
/// autorizza la lettura a chiunque appartenga al club — verificato a runtime
/// prima di scrivere questa riga. Un'attestazione che dice quanto ha versato
/// una famiglia dentro quell'endpoint sarebbe leggibile da ogni allenatore,
/// scavalcando qualunque permesso mettessimo sulla generazione. Un documento
/// generato ha quindi la sua rotta e il suo controllo.
///
/// **Perche conserva la propria resa.** Congelare versione e valori basterebbe
/// solo se il risolutore non cambiasse mai. Cambiera. Una colonna di testo
/// costa poco e toglie di mezzo un'intera classe di dubbi: un documento
/// rilasciato a marzo si rilegge a novembre identico.
///
/// **Il file firmato, quello si, e un allegato**: e un file caricato da una
/// persona, ed e esattamente cio per cui Attachment Core esiste.
model GeneratedDocument {
  id                   String                  @id @default(uuid()) @db.Uuid
  organization_id      String                  @db.Uuid
  template_id          String                  @db.Uuid
  version_id           String                  @db.Uuid
  subject_kind         String
  /// Identificativo del soggetto. Testo e non UUID perche un soggetto puo
  /// vivere in una collezione JSON (allenatori, staff, soci) e non solo in una
  /// tabella.
  subject_id           String
  /// Come si chiamava il soggetto quando il documento e stato rilasciato. Un
  /// documento storico deve restare leggibile anche se la persona viene
  /// rinominata o rimossa.
  subject_label        String?
  season_id            String?
  /// Cio che il risolutore ha scritto, chiave per chiave, in chiaro.
  values_snapshot      Json
  /// Il documento come e stato consegnato.
  content_html         String
  /// Segnaposto che il modello nomina e il risolutore non conosce.
  unresolved           String[]                @default([])
  /// Segnaposto conosciuti il cui dato mancava: sono rimasti bianchi.
  missing              String[]                @default([])
  /// Cose dette a chi ha generato **prima** di generare (firma assente…).
  warnings             String[]                @default([])
  /// Le classi sensibili che il documento contiene: decide chi puo rileggerlo.
  sensitivity          String[]                @default([])
  protocol_number      String?
  /// `generated` | `issued` | `awaiting_signature` | `signed` | `rejected` |
  /// `archived`.
  ///
  /// «Firmato» significa **una cosa sola**: e rientrata una copia firmata,
  /// caricata come allegato e citata qui sotto. Non e una firma digitale, e la
  /// schermata non la chiama cosi (ADR-0091).
  status               String                  @default("generated")
  /// L'allegato con la copia firmata, quando rientra.
  signed_attachment_id String?                 @db.Uuid
  signed_at            DateTime?
  /// Il lotto che lo ha prodotto, quando nasce da una generazione massiva.
  batch_id             String?
  generated_by         String?                 @db.Uuid
  generated_at         DateTime                @default(now())
  updated_at           DateTime                @updatedAt
  organization         Club                    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  template             DocumentTemplate        @relation(fields: [template_id], references: [id], onDelete: Restrict)
  version              DocumentTemplateVersion @relation(fields: [version_id], references: [id], onDelete: Restrict)

  /// L'idempotenza del lotto, e la ragione per cui un nuovo tentativo rigenera
  /// **solo** i falliti: dentro lo stesso `batch_id` un soggetto compare una
  /// volta sola.
  @@unique([organization_id, batch_id, subject_kind, subject_id], name: "generated_documents_batch_subject")
  @@index([organization_id, subject_kind, subject_id])
  @@index([organization_id, template_id])
  @@index([organization_id, generated_at])
  @@index([organization_id, batch_id])
  @@map("generated_documents")
}

/// Cosa il club chiede di acconsentire: privacy, immagini, trasferte.
///
/// **Perche un dominio e non una casella dentro un modulo** (ADR-0090). Un
/// consenso non e la risposta a una domanda: e uno **stato di una persona** che
/// nasce, vale e finisce. Una compilazione e immutabile per costruzione e non
/// puo rappresentare una revoca — e la revoca e meta del problema.
///
/// E la stessa distinzione gia fatta fra presenza e intenzione su
/// `training_attendance` (ADR-0086): due fatti diversi non stanno sulla stessa
/// riga.
model ConsentDefinition {
  id                String           @id @default(uuid()) @db.Uuid
  organization_id   String           @db.Uuid
  /// `privacy` | `images` | `travel` | … — la chiave con cui un modulo o un
  /// modello lo nomina.
  key               String
  title             String
  description       String?
  /// Se la sua assenza va segnalata. Non blocca niente da sola: dice al club
  /// chi manca.
  required          Boolean          @default(false)
  /// `draft` | `active` | `retired`.
  status            String           @default("draft")
  published_version Int              @default(0)
  created_by        String?          @db.Uuid
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  organization      Club             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  versions          ConsentVersion[]
  records           ConsentRecord[]

  @@unique([organization_id, key])
  @@index([organization_id, status])
  @@map("consent_definitions")
}

/// Il testo esatto che qualcuno ha accettato: **immutabile**.
///
/// Senza questa riga, «a cosa ha detto di si» diventa una domanda senza
/// risposta il giorno in cui il club corregge l'informativa.
model ConsentVersion {
  id              String            @id @default(uuid()) @db.Uuid
  organization_id String            @db.Uuid
  definition_id   String            @db.Uuid
  version         Int
  title           String
  body_text       String
  published_at    DateTime          @default(now())
  published_by    String?           @db.Uuid
  definition      ConsentDefinition @relation(fields: [definition_id], references: [id], onDelete: Cascade)
  records         ConsentRecord[]

  @@unique([definition_id, version])
  @@index([organization_id])
  @@map("consent_versions")
}

/// Una decisione: accettato, rifiutato, revocato.
///
/// **Append-only.** Una revoca non cancella l'accettazione: aggiunge una riga.
/// Il consenso dato a settembre resta dimostrabile anche dopo la revoca di
/// gennaio, ed e esattamente cio che serve se qualcuno contesta una foto
/// pubblicata a ottobre.
///
/// **Lo stato attuale non e una colonna**: e l'ultima riga per (definizione,
/// soggetto). Come per le rate e per le scadenze del lavoro sportivo, lo stato
/// si ricava e non si scrive.
model ConsentRecord {
  id              String            @id @default(uuid()) @db.Uuid
  organization_id String            @db.Uuid
  definition_id   String            @db.Uuid
  version_id      String            @db.Uuid
  /// `athlete` | `person` | `member` | `guardian`.
  subject_kind    String
  subject_id      String
  subject_label   String?
  /// `accepted` | `rejected` | `revoked`.
  status          String
  decided_at      DateTime          @default(now())
  decided_by      String?           @db.Uuid
  /// Da dove arriva: `public_form` | `internal_form` | `manual` | `import`.
  source          String            @default("manual")
  /// L'evidenza e un **puntatore**, non una copia: la compilazione o il
  /// documento generato restano dove sono.
  evidence_kind   String?
  evidence_id     String?
  note            String?
  created_at      DateTime          @default(now())
  organization    Club              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  definition      ConsentDefinition @relation(fields: [definition_id], references: [id], onDelete: Cascade)
  version         ConsentVersion    @relation(fields: [version_id], references: [id], onDelete: Restrict)

  @@index([organization_id, definition_id, subject_kind, subject_id, decided_at])
  @@index([organization_id, subject_kind, subject_id])
  @@index([organization_id, evidence_kind, evidence_id])
  @@map("consent_records")
}
