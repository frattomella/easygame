{
  "extends": [
    "next/core-web-vitals"
  ],
  "rules": {},
  "overrides": [
    {
      "files": [
        "src/app/**/*.tsx",
        "src/components/**/*.ts",
        "src/components/**/*.tsx"
      ],
      "rules": {
        "no-console": [
          "error",
          {
            "allow": [
              "error",
              "warn"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/lib/server/**/*.ts",
        "src/app/api/**/*.ts"
      ],
      "excludedFiles": [
        "src/lib/server/observability.ts"
      ],
      "rules": {
        "no-console": "error"
      }
    }
  ]
}
