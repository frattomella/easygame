{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_EASYGAME_API_URL": "https://easygame-staging-pi.vercel.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_EASYGAME_API_URL": "https://easygame-staging-pi.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_EASYGAME_API_URL": "https://easygame-staging-pi.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
