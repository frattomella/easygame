# EasyGame - ambiente locale
# Copia questo file in .env e sostituisci i placeholder.
# Non inserire segreti reali in questo file di esempio.

# PostgreSQL / Prisma
#
# In locale NON usare mai il database di staging (ADR-0012). Due opzioni:
#
#  A) Database locale in Docker — zero configurazione, consigliato:
#       docker compose -f docker-compose.dev.yml up -d
#     e usa questa connection string:
#       postgresql://easygame:easygame_dev_local@127.0.0.1:5434/easygame_dev?sslmode=disable
#
#  B) Branch Neon "development" — piu vicino alla produzione:
#     crealo dalla console Neon e incolla qui le due connection string
#     (pooled in DATABASE_URL, direct in DIRECT_URL, con sslmode=require).
#
DATABASE_URL="postgresql://easygame:easygame_dev_local@127.0.0.1:5434/easygame_dev?sslmode=disable"
DIRECT_URL="postgresql://easygame:easygame_dev_local@127.0.0.1:5434/easygame_dev?sslmode=disable"

# Ambiente del database puntato da DATABASE_URL: development | staging | production
# I comandi di scrittura (db:push, db:migrate, prisma:seed) sono consentiti solo
# con "development": vedi scripts/db-guard.mjs.
EASYGAME_DB_ENV="development"

# Password degli account demo creati da `npm run prisma:seed`.
# Minimo 16 caratteri. Non esiste una password predefinita e nessuna
# credenziale reale va scritta in questo repository.
SEED_DEMO_PASSWORD=""

# App locale
NEXT_PUBLIC_APP_URL="http://localhost:3001"
AUTH_BASE_URL="http://localhost:3001"

# Amministratori piattaforma, separati da virgola
NEXT_PUBLIC_EASYGAME_PLATFORM_ADMIN_EMAILS="admin@example.com"
EASYGAME_PLATFORM_ADMIN_EMAILS="admin@example.com"

# Automazioni / cron opzionali
CRON_SECRET=""

# Segreto con cui un cron aziona POST /api/v1/maintenance, che toglie sessioni,
# sfide OTP e contatori di rate limit scaduti. **Se resta vuoto la rotta non
# accetta il token** e si puo azionare solo da una sessione platform_admin: un
# confronto con una stringa vuota la aprirebbe a chiunque.
EASYGAME_MAINTENANCE_TOKEN=""

# Giorni di conservazione dell'audit log. **Se vuota non si cancella niente**:
# il periodo e una decisione di compliance, non un valore predefinito.
AUDIT_LOG_RETENTION_DAYS=""

# Mostra codici OTP solo in sviluppo locale. In produzione viene sempre ignorato.
AUTH_ALLOW_TEST_CODES="false"
AUTH_RATE_LIMIT_SECRET="replace-with-a-long-random-secret"

# Chiave dedicata opzionale per cifrare le credenziali dei provider di posta
# (SMTP e IMAP) salvate dal pannello admin. Le due famiglie usano contesti
# crittografici diversi, ma la stessa chiave: cambiarla le rende indecifrabili
# entrambe e vanno riconfigurate dal pannello.
# Se assente viene derivata da AUTH_RATE_LIMIT_SECRET.
SMTP_CREDENTIALS_SECRET=""

# SMS verification opzionale
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# OAuth opzionale
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""


# --- Pagamenti online (Stripe) ---------------------------------------------
#
# Senza queste variabili il pagamento online resta spento e l'interfaccia lo
# dice, invece di offrirlo e fallire davanti a chi paga (ADR-0049, ADR-0051).
#
# EasyGame usa Stripe per **due flussi diversi** che condividono la chiave
# segreta ma non l'endpoint webhook:
#
#   B) atleta/genitore -> club: addebiti diretti su account connessi, con la
#      commissione della piattaforma trattenuta sull'incasso;
#   A) club -> Cedi Soft: abbonamenti EasyGame sull'account centrale.
#
# STRIPE_SECRET_KEY e la chiave della **piattaforma**, non del club: gli
# account dei club sono account connessi e non hanno chiavi qui dentro.
STRIPE_SECRET_KEY=""
#
# Il segreto dell'endpoint webhook **degli incassi** (comincia con whsec_).
# Senza, /api/payments/webhook risponde 503 e non crede a niente: e il segreto
# a distinguere un evento del PSP da un POST qualunque.
# Attenzione: la chiave dell'endpoint registrato in dashboard e diversa da
# quella stampata da `stripe listen`.
STRIPE_WEBHOOK_SECRET=""
#
# Il segreto dell'endpoint webhook **degli abbonamenti EasyGame**. E una
# variabile distinta e non un vezzo: sono due account con due segreti, e
# riusarne uno solo renderebbe impossibile ruotarlo senza fermare l'altro
# flusso. Senza, /api/billing/webhook risponde 503.
STRIPE_BILLING_WEBHOOK_SECRET=""
#
# `test` finche non si incassa denaro vero. Compare nell'interfaccia.
PAYMENT_MODE="test"
#
# La commissione predefinita **non sta piu qui**: dal Blocco D le condizioni
# commerciali stanno in `platform_commission_rules` e si scrivono dalla
# console di piattaforma, con una data di decorrenza (ADR-0050). Questa
# variabile resta solo come valore di riserva quando nessuna condizione e
# stata ancora scritta.
PLATFORM_FEE_PERCENT="1"
